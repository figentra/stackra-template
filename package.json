{
  "name": "stackra-template-preview",
  "version": "0.0.0",
  "private": true,
  "description": "Stackra reference template: the v2 programming model in one pnpm + Turborepo workspace (apps, services, packages by category, tooling presets).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install && stackra mcp sync",
    "dev": "stackra dev",
    "gen": "stackra gen",
    "gen:check": "stackra gen --check",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "oxfmt --write .",
    "format:check": "turbo run format:check",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "verify": "stackra verify",
    "validate": "stackra validate",
    "new": "stackra new",
    "structure": "stackra structure",
    "doctor": "stackra doctor",
    "db:diff": "stackra db diff",
    "db:migrate": "stackra db migrate",
    "db:seed": "stackra db seed",
    "infra": "stackra infra preview",
    "console": "turbo run dev --filter=@acme/console",
    "web": "turbo run dev --filter=@acme/web",
    "mobile": "turbo run dev --filter=@acme/mobile",
    "docs": "turbo run dev --filter=@acme/docs",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "secrets:scan": "gitleaks git . --config .gitleaks.toml --no-banner --redact",
    "agents:setup": "stackra agents setup"
  },
  "devDependencies": {
    "@changesets/changelog-git": "catalog:release",
    "@changesets/cli": "catalog:release",
    "@commitlint/cli": "catalog:release",
    "@stackra/cli": "catalog:stackra",
    "@stackra/commitlint-config": "workspace:*",
    "@stackra/oxlint-config": "workspace:*",
    "@stackra/runway": "catalog:stackra",
    "@stackra/testing": "catalog:stackra",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "knip": "catalog:quality",
    "lefthook": "catalog:release",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "turbo": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.6.0"
}
