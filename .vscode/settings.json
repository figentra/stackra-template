// Stackra file contract:
// Purpose: shared workspace settings: oxfmt formats and oxlint lints through the Oxc extension,
//          TypeScript 7 runs through its native extension, config files get their schemas, and the
//          editor applies the .editorconfig rules. Personal preferences (theme, font, keybindings)
//          belong in user settings.
// Boundary: editor behaviour only. The formatter and linter configs are .oxfmtrc.jsonc and
//           .oxlintrc.jsonc; the editor, lefthook and CI read the same files, so a file saved here
//           passes `pnpm format:check` (CONTRIBUTING.md, "Formatting and spelling").
// Runtime: node
// Governing contract: Stackra ADR 0227 (Prettier and ESLint are rejected; oxfmt and oxlint replace
//                     them)
{
  // ── Format: oxfmt on save ───────────────────────────────────────────────────────────────────────
  // oxfmt formats whole files only: "Format Selection" and format-on-type/paste are unsupported, so
  // save formats the file ("file" mode), never just the modified ranges.
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.formatOnType": false,
  "editor.formatOnPaste": false,
  "editor.rulers": [100],
  "[typescript][typescriptreact][javascript][javascriptreact][json][json5][yaml][markdown][mdx][toml][css][html]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  // JSONC (turbo.jsonc, knip.jsonc, the oxlint presets) formats on save with VS Code's JSON formatter,
  // which keeps every comment in place; oxfmt still checks those files in the hook and CI, and with
  // no trailing commas (.oxfmtrc.jsonc) the two agree.
  "[jsonc]": { "editor.defaultFormatter": "vscode.json-language-features" },
  // .editorconfig keeps trailing whitespace in Markdown (hard line breaks).
  "[markdown]": { "files.trimTrailingWhitespace": false },
  // Even Better TOML stays for validation, completion and schemas only; the [toml] formatter above is
  // oxfmt.

  // ── Lint: oxlint (config .oxlintrc.jsonc), fixes on explicit save action ────────────────────────
  "oxc.enable": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },

  // ── .editorconfig ───────────────────────────────────────────────────────────────────────────────
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,

  // ── TypeScript: the TypeScript 7 extension (native), `#` subpath imports ────────────────────────
  // TypeScript 7 ships only the native compiler and language server (no tsserver.js), so the editor
  // runs the "TypeScript 7" extension (TypeScriptTeam.native-preview) with its bundled native build
  // instead of a `typescript.tsdk` path. Members compile with the catalog's TypeScript 7.
  "js/ts.experimental.useTsgo": true,
  "js/ts.preferences.importModuleSpecifier": "non-relative",
  "js/ts.preferences.preferTypeOnlyAutoImports": true,
  "js/ts.updateImportsOnFileMove.enabled": "always",

  // ── File types the editor cannot guess ──────────────────────────────────────────────────────────
  "files.associations": {
    // The tsconfig presets carry a contract comment but no tsconfig*.json name.
    "**/packages/tooling/typescript/src/*.json": "jsonc",
    // eas.json carries its contract as `//` lines (eas-cli reads it as JSON5 and refuses `$comment`).
    "**/eas.json": "jsonc",
    // CODEOWNERS is `path owner` lines with `#` comments, not Markdown.
    "CODEOWNERS": "ignore"
  },

  // ── JSON schemas ────────────────────────────────────────────────────────────────────────────────
  // Remote $schema URLs load only from trusted hosts (VS Code shows "Location ... is untrusted"
  // otherwise). Local paths (./schemas) need no entry.
  "json.schemaDownload.enable": true,
  "json.schemaDownload.trustedDomains": {
    "https://json.schemastore.org/": true,
    "https://www.schemastore.org/": true,
    "https://unpkg.com/": true,
    "https://raw.githubusercontent.com/": true,
    "https://turborepo.dev/": true,
    "https://mintlify.com/": true,
    "https://spec.openapis.org/": true,
    "https://docs.renovatebot.com/": true,
    "https://static.stackra.figentra.com/schemas/": true
  },
  // A file's own `$schema` wins over these mappings, so they cover only files that carry none.
  "json.schemas": [
    // Claude Code's preview servers (.claude/launch.json), from SchemaStore.
    {
      "fileMatch": ["**/.claude/launch.json"],
      "url": "https://www.schemastore.org/claude-code-launch.json"
    },
    // The tsconfig presets have no tsconfig*.json name, so VS Code would not recognise them.
    {
      "fileMatch": ["**/packages/tooling/typescript/src/*.json"],
      "url": "https://www.schemastore.org/tsconfig.json"
    },
    // The oxlint presets: oxlint's own schema at the catalog version (1.86.0).
    {
      "fileMatch": ["**/packages/tooling/oxlint/src/*.jsonc"],
      "url": "https://unpkg.com/oxlint@1.86.0/configuration_schema.json"
    },
    // EAS build profiles, including the generated apps/mobile/.stackra/eas.json (eas-cli in mise.toml).
    {
      "fileMatch": ["**/eas.json"],
      "url": "https://raw.githubusercontent.com/expo/eas-cli/v25.3.0/packages/eas-json/schema/eas.schema.json"
    },
    // Generated OpenAPI documents (`openapi: 3.1.0`): the official OAS 3.1 schema.
    {
      "fileMatch": ["**/openapi.json"],
      "url": "https://spec.openapis.org/oas/3.1/schema/2022-10-07"
    }
  ],

  // ── YAML: schemas for the files that carry no modeline ──────────────────────────────────────────
  // Most YAML files name their schema in a `# yaml-language-server: $schema=` first line, which wins
  // over these mappings; SchemaStore stays on as a fallback for files listed nowhere.
  "yaml.format.enable": false,
  "yaml.validate": true,
  "yaml.schemaStore.enable": true,
  "yaml.schemas": {
    // electron-builder's own schema (SchemaStore's copy predates the `universal` arch).
    "https://unpkg.com/app-builder-lib@26.15.3/scheme.json": "**/electron-builder.yml",
    // Maestro flows and the GitHub workflows, from SchemaStore.
    "https://www.schemastore.org/maestro-flow.json": "**/*.flow.yaml",
    "https://json.schemastore.org/github-workflow.json": ".github/workflows/*.yml"
  },

  // ── CSS: Tailwind v4 and Uniwind at-rules (@theme, @source, @custom-variant, @utility) ──────────
  "css.lint.unknownAtRules": "ignore",

  // ── Tailwind v4 / Uniwind class names in className, cn() and tv() ───────────────────────────────
  "tailwindCSS.classFunctions": ["cn", "tv"],
  "tailwindCSS.classAttributes": ["class", "className", "classNames"],

  // ── i18n: assets/lang/<locale>/<namespace>.json in every member (BCP 47 tags: `en`, `ar-SA`) ─────
  "i18n-ally.localesPaths": [
    "apps/*/assets/lang",
    "services/*/assets/lang",
    "packages/*/*/assets/lang"
  ],
  "i18n-ally.pathMatcher": "{locale}/{namespaces}.json",
  "i18n-ally.namespace": true,
  "i18n-ally.keystyle": "nested",
  "i18n-ally.sourceLanguage": "en",
  "i18n-ally.displayLanguage": "en",
  "i18n-ally.enabledFrameworks": ["general"],

  // ── Markdown: oxfmt formats, markdownlint checks structure (rules in .markdownlint.yaml) ─────────
  "markdown.validate.enabled": true,

  // ── Tests ───────────────────────────────────────────────────────────────────────────────────────
  "playwright.reuseBrowser": true,

  // ── Explorer: nest companion files under the file they belong to ────────────────────────────────
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    // Workspace, toolchain, lint, format and spelling configs under the root manifest.
    "package.json": "pnpm-workspace.yaml, pnpm-lock.yaml, turbo.jsonc, knip.jsonc, mise.toml, .node-version, .oxlintrc.jsonc, .oxfmtrc.jsonc, .markdownlint.yaml, cspell.config.yaml, .editorconfig, renovate.json5",
    // Git hooks with the commit and secret rules they run.
    "lefthook.yml": ".commitlintrc.yaml, .gitleaks.toml",
    ".gitignore": ".gitattributes",
    // The policies a reader opens from the README.
    "README.md": "CONTRIBUTING.md, SECURITY.md, LICENSE, NOTICE",
    // Claude Code's entry imports AGENTS.md; .mcp.yaml stays top-level, where agents look for it.
    "AGENTS.md": "CLAUDE.md",
    "runway.yaml": "stackra.lock.yaml"
  },

  // ── Search and watching: skip generated output, build output and caches ─────────────────────────
  // `.stackra/` is gen output: excluded from search only. It stays watched, so the TypeScript server
  // sees each gen rewrite without a window reload, and it has no `files.exclude` entry, so it stays
  // visible in the explorer for reading what gen wrote.
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/.turbo/**": true,
    "**/coverage/**": true,
    "**/.cache/**": true,
    "**/.expo/**": true
  },
  "search.exclude": {
    "**/.stackra": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/.turbo": true,
    "**/coverage": true,
    "**/.cache": true,
    "pnpm-lock.yaml": true
  },

  // ── Git: the repo's own hooks run through lefthook ──────────────────────────────────────────────
  "git.allowNoVerifyCommit": false,
  "git.branchProtection": ["main"],
  "git.branchProtectionPrompt": "alwaysPrompt"
}
