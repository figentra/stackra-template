// Stackra file contract:
// Purpose: the extensions VS Code recommends when this repository opens: one formatter (oxfmt) and
//          one linter (oxlint) through Oxc, the TypeScript 7 language service, the test runners,
//          config schemas, spelling, i18n and data tools.
// Boundary: recommendations only; settings live in .vscode/settings.json. Prettier and ESLint are
//           listed as unwanted.
// Runtime: node
// Governing contract: Stackra ADR 0227 (Prettier and ESLint are rejected,
//                     https://docs.stackra.figentra.com/adr/0227-rejected-and-deferred-technologies-refreshed)
{
  "recommendations": [
    // TypeScript 7: the native language service (settings.json `js/ts.experimental.useTsgo`).
    "TypeScriptTeam.native-preview",
    // Format and lint: oxfmt + oxlint
    "oxc.oxc-vscode",
    "editorconfig.editorconfig",
    // Tests: vitest (unit, int, contract) and Playwright (e2e)
    "vitest.explorer",
    "ms-playwright.playwright",
    // Config files: YAML (runway, workflows, lefthook), TOML (mise; validation and schemas only,
    // oxfmt formats it), MDX (docs)
    "redhat.vscode-yaml",
    "tamasfe.even-better-toml",
    "unifiedjs.vscode-mdx",
    "github.vscode-github-actions",
    // UI: Tailwind v4 / Uniwind class names, Expo
    "bradlc.vscode-tailwindcss",
    "expo.vscode-expo-tools",
    // TypeScript errors you can read, inline
    "yoavbls.pretty-ts-errors",
    "usernamehw.errorlens",
    // Docs: Markdown rules (oxfmt formats; markdownlint flags structure) and Mermaid in previews
    "davidanson.vscode-markdownlint",
    "bierner.markdown-mermaid",
    // Spelling: cspell.config.yaml (also enforced by lefthook and CI) with the British English
    // dictionary it selects (`language: en-GB,en`)
    "streetsidesoftware.code-spell-checker",
    "streetsidesoftware.code-spell-checker-british-english",
    // i18n keys in assets/lang/<locale>/<namespace>.json, inline and with missing-key reports
    "lokalise.i18n-ally",
    // Data: Postgres through SQLTools, and SQLite files (the desktop offline store)
    "mtxr.sqltools",
    "mtxr.sqltools-driver-pg",
    "qwtel.sqlite-viewer",
    // Containers (generated compose files) and pull-request review in the editor
    "ms-azuretools.vscode-docker",
    "github.vscode-pull-request-github",
    // AI pair: Claude Code
    "anthropic.claude-code"
  ],
  "unwantedRecommendations": [
    "esbenp.prettier-vscode",
    "dbaeumer.vscode-eslint",
    "rvest.vs-code-prettier-eslint"
  ]
}
