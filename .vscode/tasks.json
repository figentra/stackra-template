// Stackra file contract:
// Purpose: the tasks in the command palette (Tasks: Run Task) and the default build and test
//          shortcuts, each a root `pnpm` script.
// Boundary: task wiring only; the commands themselves are package.json scripts. Problem matchers are
//           empty because each tool prints its own file:line findings.
// Runtime: node
// Governing contract: Stackra ADR 0027 (one toolchain for editor, hooks and CI)
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "verify",
      "detail": "Full gate: format, lint, typecheck, test, build, gen check, validate, boundaries, knip",
      "type": "shell",
      "command": "pnpm verify",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "gen",
      "detail": "stackra gen: regenerate .stackra/ for every member",
      "type": "shell",
      "command": "pnpm gen",
      "problemMatcher": []
    },
    {
      "label": "test",
      "detail": "Every member's vitest suite",
      "type": "shell",
      "command": "pnpm test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "dev",
      "detail": "stackra dev: dev servers for the chosen members",
      "type": "shell",
      "command": "pnpm dev",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "format",
      "detail": "oxfmt the whole repo",
      "type": "shell",
      "command": "pnpm format",
      "problemMatcher": []
    },
    {
      "label": "spell",
      "detail": "cspell over Markdown, TypeScript, CSS and YAML (cspell.config.yaml)",
      "type": "shell",
      "command": "pnpm spell",
      "problemMatcher": []
    }
  ]
}
