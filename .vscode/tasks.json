// Stackra file contract:
// Purpose: the tasks in the command palette (Tasks: Run Task) and the default build and test
//          shortcuts, each a root `pnpm` script.
// Boundary: task wiring only; the commands themselves are package.json scripts. Problem matchers are
//           empty because each tool prints its own file:line findings.
// Runtime: node
// Governing contract: Stackra ADR 0027 (one toolchain for editor, hooks and CI)
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "verify",
      "detail": "Full gate: format, lint, typecheck, test, build, gen check, validate, boundaries, knip",
      "type": "shell",
      "command": "pnpm verify",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "gen",
      "detail": "stackra gen: regenerate .stackra/ for every member",
      "type": "shell",
      "command": "pnpm gen",
      "problemMatcher": []
    },
    {
      "label": "test",
      "detail": "Every member's vitest suite",
      "type": "shell",
      "command": "pnpm test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "dev",
      "detail": "stackra dev: dev servers for the chosen members",
      "type": "shell",
      "command": "pnpm dev",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "format",
      "detail": "oxfmt the whole repo",
      "type": "shell",
      "command": "pnpm format",
      "problemMatcher": []
    },
    {
      "label": "spell",
      "detail": "cspell over Markdown, TypeScript, CSS and YAML (cspell.config.yaml)",
      "type": "shell",
      "command": "pnpm spell",
      "problemMatcher": []
    },
    {
      "label": "dev: surface-console",
      "detail": "Start surface-console on http://localhost:4173 (written by stackra gen from the runways)",
      "type": "shell",
      "command": "pnpm exec stackra build --product --surfaces-only && exec pnpm exec stackra preview serve --surface console --port 4173",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "dev: surface-landing",
      "detail": "Start surface-landing on http://localhost:4174 (written by stackra gen from the runways)",
      "type": "shell",
      "command": "pnpm exec stackra build --product --surfaces-only && exec pnpm exec stackra preview serve --surface landing --port 4174",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "dev: console",
      "detail": "Start console on http://localhost:3710 (written by stackra gen from the runways)",
      "type": "shell",
      "command": "pnpm turbo run build --output-logs=errors-only --filter=@figentra/acme-console^... && exec pnpm --filter @figentra/acme-console run dev",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "dev: docs",
      "detail": "Start docs on http://localhost:3333 (written by stackra gen from the runways)",
      "type": "shell",
      "command": "pnpm turbo run build --output-logs=errors-only --filter=@acme/docs^... && exec pnpm --filter @acme/docs run dev",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
