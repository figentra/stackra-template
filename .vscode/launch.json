// Stackra file contract:
// Purpose: debug configurations: Vitest for the open test file, Node for the open script, and attach
//          targets for the services, the web apps, Electron and the Expo app.
// Boundary: debugger wiring only. Dev servers start with `pnpm dev` (stackra dev); member ports
//           come from each member's runway.yaml and shift by the worktree lane (100 per lane), so
//           every port that can move is prompted for, with the lane-0 default filled in.
// Runtime: node
// Governing contract: Stackra ADR 0168 (runway.yaml owns ports)
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Vitest: current test file",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["exec", "vitest", "run", "${file}"],
      // Packages and services: run from the file's folder so the member's own vitest config applies.
      "cwd": "${fileDirname}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      // Apps keep their vitest config in .stackra/ (written by `stackra gen`), which vitest never
      // finds on its own, so this variant passes it explicitly.
      "name": "Vitest: current app test file",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["exec", "vitest", "run", "--config", ".stackra/vitest.config.ts", "${file}"],
      "cwd": "${workspaceFolder}/apps/${input:app}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "Node: current file",
      "type": "node",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      // `stackra dev --inspect` opens one inspector per service process; pick the one to attach to.
      "name": "Attach: service (stackra dev --inspect)",
      "type": "node",
      "request": "attach",
      "port": "${input:inspectorPort}",
      "restart": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "Web: debug in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:${input:devPort}",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Desktop: Electron main",
      "type": "node",
      "request": "attach",
      "port": 9230,
      "restart": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Desktop: Electron renderer",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}/apps/console"
    },
    {
      "name": "Mobile: attach to Expo (Hermes)",
      "type": "expo",
      "request": "attach",
      "projectRoot": "${workspaceFolder}/apps/mobile",
      "bundlerPort": "${input:metroPort}"
    }
  ],
  "compounds": [
    {
      "name": "Desktop: main + renderer",
      "configurations": ["Desktop: Electron main", "Desktop: Electron renderer"],
      "stopAll": true
    }
  ],
  "inputs": [
    {
      "id": "app",
      "type": "pickString",
      "description": "App whose test file is open",
      "options": ["console", "web", "mobile"]
    },
    {
      "id": "devPort",
      "type": "promptString",
      "description": "Dev server port (the member's runway.yaml `dev.port`, plus 100 per worktree lane)"
    },
    {
      "id": "inspectorPort",
      "type": "promptString",
      "description": "Service inspector port printed by `stackra dev --inspect`",
      "default": "9229"
    },
    {
      "id": "metroPort",
      "type": "promptString",
      "description": "Metro port (apps/mobile runway.yaml `dev.port`, plus 100 per worktree lane)",
      "default": "8081"
    }
  ]
}
