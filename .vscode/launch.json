// Stackra file contract:
// Purpose: debug configurations: Vitest for the open test file, Node for the open script, and attach
//          targets for the services and a web app's dev server.
// Boundary: debugger wiring only. Dev servers start with `pnpm dev` (stackra dev); member ports
//           come from each member's runway.yaml and shift by the worktree lane (100 per lane), so
//           every port that can move is prompted for, with the lane-0 default filled in.
// Runtime: node
// Governing contract: Stackra ADR 0296 (the member runway owns its ports), Stackra ADR 0295
//                     decision 5 (generated tool configs and their root shims)
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Vitest: current test file",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["exec", "vitest", "run", "${file}"],
      // Run from the file's folder: vitest walks up to the member root, where the gitignored shim
      // `stackra gen` writes re-exports the member's `.stackra/vitest.config.ts`.
      "cwd": "${fileDirname}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "Node: current file",
      "type": "node",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      // `stackra dev --inspect` opens one inspector per service process; pick the one to attach to.
      "name": "Attach: service (stackra dev --inspect)",
      "type": "node",
      "request": "attach",
      "port": "${input:inspectorPort}",
      "restart": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "Web: debug in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:${input:devPort}",
      "webRoot": "${workspaceFolder}"
    }
  ],
  "inputs": [
    {
      "id": "devPort",
      "type": "promptString",
      "description": "Dev server port (the member's runway.yaml `environments.dev.port`, plus 100 per worktree lane)"
    },
    {
      "id": "inspectorPort",
      "type": "promptString",
      "description": "Service inspector port printed by `stackra dev --inspect`",
      "default": "9229"
    }
  ]
}
