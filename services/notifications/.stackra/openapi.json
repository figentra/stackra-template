  "openapi": "3.1.0",
  "info": {
    "title": "@figentra/service-notifications",
    "version": "0.1.0"
  },
  "paths": {
    "/messages": {
      "post": {
        "operationId": "messages.message.send",
        "x-stackra-permission": "messages.message.send",
        "x-stackra-risk": "L1",
        "x-stackra-idempotency": "derived",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mail", "to", "subject", "html", "text"],
                "properties": {
                  "mail": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "to": {
                    "type": "object",
                    "required": ["principalId"],
                    "properties": {
                      "principalId": {
                        "type": "string"
                      }
                    }
                  },
                  "subject": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "html": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["messageId"],
                  "properties": {
                    "messageId": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/Refusal",
            "x-stackra-codes": ["rate_limited"]
          }
        }
      }
    },
    "/notifications": {
      "get": {
        "operationId": "messages.notification.list",
        "x-stackra-permission": "messages.notification.read",
        "x-stackra-risk": "L0",
        "x-stackra-query": {
          "$ref": "#/components/schemas/NotificationListFilter"
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationPage"
                }
              }
            }
          }
        }
      }
    },
    "/notifications/{notificationId}/read": {
      "put": {
        "operationId": "messages.notification.mark_read",
        "x-stackra-permission": "messages.notification.update",
        "x-stackra-risk": "L0",
        "parameters": [
          {
            "name": "notificationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationView"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Refusal",
            "x-stackra-codes": ["notification_not_found"]
          }
        }
      }
    },
    "/webhooks/inbound-mail": {
      "post": {
        "operationId": "InboundMailWebhook.receive",
        "security": [],
        "x-stackra-area": "public",
        "x-stackra-signature": "standard_webhooks",
        "responses": {
          "200": {
            "description": "accepted"
          },
          "401": {
            "$ref": "#/components/responses/Refusal",
            "x-stackra-codes": ["invalid_signature"]
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DeliverMessageInput": {
        "type": "object",
        "required": ["messageId", "html", "text"],
        "properties": {
          "messageId": {
            "type": "string"
          },
          "html": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "DeliverMessageOutput": {
        "type": "object",
        "required": ["messageId", "status"],
        "properties": {
          "messageId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["queued", "sent", "failed"]
          }
        }
      },
      "MarkNotificationReadInput": {
        "type": "object",
        "required": ["notificationId"],
        "properties": {
          "notificationId": {
            "type": "string"
          }
        }
      },
      "NotificationListFilter": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          },
          "unreadOnly": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "NotificationView": {
        "type": "object",
        "required": ["id", "kind", "data", "createdAt", "readAt"],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": ["order_paid"]
          },
          "data": {
            "type": "object",
            "additionalProperties": {
              "type": ["string", "number"]
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "readAt": {
            "type": ["string", "null"],
            "format": "date-time"
          }
        }
      },
      "NotificationPage": {
        "type": "object",
        "required": ["items", "hasMore", "unread"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NotificationView"
            }
          },
          "nextCursor": {
            "type": "string"
          },
          "hasMore": {
            "type": "boolean"
          },
          "unread": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "responses": {
      "Refusal": {
        "description": "The error envelope of ADR 0140: { code, category, retryable, details }"
      }
    }
  }
