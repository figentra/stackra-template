{
  "name": "@acme/service-notifications",
  "version": "0.1.0",
  "private": true,
  "description": "The consumer service: delivery, notification preferences, the message log and the in-app inbox as kind classes found by their group folders. Reaches commerce by an event, a call and a queued call through the generated client, never its code; stackra gen writes the entry, the wiring and the Encore app into .stackra/.",
  "license": "UNLICENSED",
  "type": "module",
  "imports": {
    "#src/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ],
    "#modules/*": [
      "./src/modules/*",
      "./src/modules/*.ts",
      "./src/modules/*.tsx",
      "./src/modules/*/index.ts"
    ],
    "#config/*": [
      "./src/config/*",
      "./src/config/*.ts",
      "./src/config/*.tsx",
      "./src/config/*/index.ts"
    ],
    "#assets/*": "./assets/*",
    "#stackra/*": [
      "./.stackra/gen/*",
      "./.stackra/gen/*.ts",
      "./.stackra/gen/*.tsx",
      "./.stackra/gen/*/index.ts"
    ]
  },
  "exports": {
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "gen": "stackra gen",
    "dev": "stackra dev",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "build": "stackra build"
  },
  "dependencies": {
    "@stackra/actions": "catalog:stackra",
    "@stackra/app": "catalog:stackra",
    "@stackra/clients": "catalog:stackra",
    "@stackra/config": "catalog:stackra",
    "@stackra/container": "catalog:stackra",
    "@stackra/contracts": "catalog:stackra",
    "@stackra/database": "catalog:stackra",
    "@stackra/errors": "catalog:stackra",
    "@stackra/events": "catalog:stackra",
    "@stackra/i18n": "catalog:stackra",
    "@stackra/iam": "catalog:stackra",
    "@stackra/identity": "catalog:stackra",
    "@stackra/integrations": "catalog:stackra",
    "@stackra/model": "catalog:stackra",
    "@stackra/notifications": "catalog:stackra",
    "@stackra/outbox": "catalog:stackra",
    "@stackra/queue": "catalog:stackra",
    "@stackra/settings": "catalog:stackra",
    "@stackra/transport": "catalog:stackra",
    "@stackra/validation": "catalog:stackra",
    "@stackra/webhooks": "catalog:stackra",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@stackra/runway": "catalog:stackra",
    "@stackra/testing": "catalog:stackra",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  }
}
