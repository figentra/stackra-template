{
  "name": "@figentra/acme-service-example",
  "version": "0.0.0",
  "private": true,
  "description": "An example service: one tenant-owned resource (notes) through the actions pipeline; rename it to the product's first service or delete it.",
  "keywords": ["stackra"],
  "license": "UNLICENSED",
  "type": "module",
  "imports": {
    "#src/*": ["./src/*", "./src/*.ts", "./src/*.tsx", "./src/*/index.ts"],
    "#config/*": [
      "./src/config/*",
      "./src/config/*.ts",
      "./src/config/*.tsx",
      "./src/config/*/index.ts"
    ],
    "#contracts/*": [
      "./src/contracts/*",
      "./src/contracts/*.ts",
      "./src/contracts/*.tsx",
      "./src/contracts/*/index.ts"
    ],
    "#modules/*": [
      "./src/modules/*",
      "./src/modules/*.ts",
      "./src/modules/*.tsx",
      "./src/modules/*/index.ts"
    ],
    "#assets/*": "./assets/*",
    "#stackra/*": [
      "./.stackra/gen/*",
      "./.stackra/gen/*.ts",
      "./.stackra/gen/*.tsx",
      "./.stackra/gen/*/index.ts"
    ]
  },
  "exports": {
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "dev": "stackra dev",
    "build": "stackra build",
    "typecheck": "stackra typecheck",
    "lint": "stackra lint",
    "test": "stackra test",
    "test:int": "stackra test --tier int",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist coverage .turbo .stackra"
  },
  "dependencies": {
    "@stackra/access-log": "catalog:stackra",
    "@stackra/actions": "catalog:stackra",
    "@stackra/app": "catalog:stackra",
    "@stackra/config": "catalog:stackra",
    "@stackra/console": "catalog:stackra",
    "@stackra/container": "catalog:stackra",
    "@stackra/contracts": "catalog:stackra",
    "@stackra/data-maintenance": "catalog:stackra",
    "@stackra/database": "catalog:stackra",
    "@stackra/entitlements": "catalog:stackra",
    "@stackra/errors": "catalog:stackra",
    "@stackra/events": "catalog:stackra",
    "@stackra/filesystem": "catalog:stackra",
    "@stackra/iam": "catalog:stackra",
    "@stackra/logger": "catalog:stackra",
    "@stackra/model": "catalog:stackra",
    "@stackra/privacy": "catalog:stackra",
    "@stackra/queue": "catalog:stackra",
    "@stackra/scheduler": "catalog:stackra",
    "@stackra/scope": "catalog:stackra",
    "@stackra/tenancy": "catalog:stackra",
    "@stackra/validation": "catalog:stackra",
    "encore.dev": "1.58.8",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@faker-js/faker": "catalog:",
    "@stackra/cli": "catalog:stackra",
    "@stackra/testing": "catalog:stackra",
    "@stackra/tsdown-config": "catalog:stackra",
    "@stackra/typescript-config": "catalog:stackra",
    "@stackra/vitest-config": "catalog:stackra",
    "@testcontainers/postgresql": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "testcontainers": "catalog:",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "service",
    "runtimes": ["node"]
  }
}
