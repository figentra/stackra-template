{
  "name": "@figentra/acme-service-example",
  "version": "0.0.0",
  "private": true,
  "description": "An example service: rename it to the product's first service or delete it.",
  "keywords": [
    "stackra"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#src/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ],
    "#config/*": [
      "./src/config/*",
      "./src/config/*.ts",
      "./src/config/*.tsx",
      "./src/config/*/index.ts"
    ],
    "#contracts/*": [
      "./src/contracts/*",
      "./src/contracts/*.ts",
      "./src/contracts/*.tsx",
      "./src/contracts/*/index.ts"
    ],
    "#modules/*": [
      "./src/modules/*",
      "./src/modules/*.ts",
      "./src/modules/*.tsx",
      "./src/modules/*/index.ts"
    ],
    "#assets/*": "./assets/*",
    "#stackra/*": [
      "./.stackra/gen/*",
      "./.stackra/gen/*.ts",
      "./.stackra/gen/*.tsx",
      "./.stackra/gen/*/index.ts"
    ]
  },
  "exports": {
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "dev": "stackra dev",
    "build": "stackra build",
    "typecheck": "stackra typecheck",
    "lint": "stackra lint",
    "test": "stackra test",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist coverage .turbo .stackra"
  },
  "dependencies": {
    "@stackra/app": "catalog:stackra",
    "@stackra/contracts": "catalog:stackra"
  },
  "devDependencies": {
    "@stackra/cli": "catalog:stackra",
    "@stackra/tsdown-config": "catalog:stackra",
    "@stackra/typescript-config": "catalog:stackra",
    "@stackra/vitest-config": "catalog:stackra",
    "@types/node": "catalog:",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "service",
    "runtimes": [
      "node"
    ]
  }
}
