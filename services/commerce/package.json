{
  "name": "@acme/service-commerce",
  "version": "0.1.0",
  "private": true,
  "description": "The reference service: catalogue, inventory, orders and loyalty modules as kind classes (actions, queries, models, workflows, events) found by their group folders; stackra gen writes the entry, the wiring and the Encore app into .stackra/.",
  "license": "UNLICENSED",
  "type": "module",
  "imports": {
    "#src/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ],
    "#modules/*": [
      "./src/modules/*",
      "./src/modules/*.ts",
      "./src/modules/*.tsx",
      "./src/modules/*/index.ts"
    ],
    "#config/*": [
      "./src/config/*",
      "./src/config/*.ts",
      "./src/config/*.tsx",
      "./src/config/*/index.ts"
    ],
    "#assets/*": "./assets/*",
    "#stackra/*": [
      "./.stackra/gen/*",
      "./.stackra/gen/*.ts",
      "./.stackra/gen/*.tsx",
      "./.stackra/gen/*/index.ts"
    ]
  },
  "exports": {
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "gen": "stackra gen",
    "dev": "stackra dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "stackra build",
    "lint": "oxlint .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@acme/access-log": "workspace:*",
    "@acme/loyalty-kit": "workspace:*",
    "@react-email/components": "catalog:",
    "@stackra/actions": "catalog:stackra",
    "@stackra/ai": "catalog:stackra",
    "@stackra/app": "catalog:stackra",
    "@stackra/assets": "catalog:stackra",
    "@stackra/cache": "catalog:stackra",
    "@stackra/clients": "catalog:stackra",
    "@stackra/config": "catalog:stackra",
    "@stackra/container": "catalog:stackra",
    "@stackra/contracts": "catalog:stackra",
    "@stackra/database": "catalog:stackra",
    "@stackra/entitlements": "catalog:stackra",
    "@stackra/errors": "catalog:stackra",
    "@stackra/events": "catalog:stackra",
    "@stackra/feature-flags": "catalog:stackra",
    "@stackra/i18n": "catalog:stackra",
    "@stackra/iam": "catalog:stackra",
    "@stackra/locking": "catalog:stackra",
    "@stackra/logger": "catalog:stackra",
    "@stackra/media": "catalog:stackra",
    "@stackra/model": "catalog:stackra",
    "@stackra/money": "catalog:stackra",
    "@stackra/notifications": "catalog:stackra",
    "@stackra/outbox": "catalog:stackra",
    "@stackra/panel": "catalog:stackra",
    "@stackra/queue": "catalog:stackra",
    "@stackra/realtime": "catalog:stackra",
    "@stackra/scheduler": "catalog:stackra",
    "@stackra/search": "catalog:stackra",
    "@stackra/settings": "catalog:stackra",
    "@stackra/state-machine": "catalog:stackra",
    "@stackra/support": "catalog:stackra",
    "@stackra/tenancy": "catalog:stackra",
    "@stackra/transport": "catalog:stackra",
    "@stackra/ui": "catalog:stackra",
    "@stackra/validation": "catalog:stackra",
    "@stackra/versioning": "catalog:stackra",
    "@stackra/webhooks": "catalog:stackra",
    "@stackra/workflow": "catalog:stackra",
    "react": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@stackra/gen": "catalog:stackra",
    "@stackra/runway": "catalog:stackra",
    "@stackra/testing": "catalog:stackra",
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  }
}
