// Stackra file contract:
// Purpose: oxfmt settings for the whole workspace: a code width of 100 columns (Markdown prose keeps
//          its own wrapping, proseWrap preserve), and the generated or upstream files that are never
//          reformatted.
// Boundary: formatter options and ignores only; adding an ignore pattern needs a reason beside it.
// Runtime: node
// Governing contract: ADR 0007 (docblocks wrap at the same width)
{
  "$schema": "https://unpkg.com/oxfmt@0.71.0/configuration_schema.json",
  "printWidth": 100,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    // generated by stackra gen, never hand-formatted
    "**/.stackra/gen/**",
    // Expo: generated native projects and the CLI cache
    "**/ios/**",
    "**/android/**",
    "**/.expo/**",
    // generated by tools
    "**/CHANGELOG.md",
    "pnpm-lock.yaml",
    // rendered from .mcp.yaml by `stackra mcp sync` (gitignored)
    ".mcp.json",
  ],
}
