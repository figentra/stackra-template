// Stackra file contract:
// Purpose: oxfmt settings for the whole workspace: code at 100 columns, Markdown prose wrapped at the
//          same width, JSONC without trailing commas, and the generated or upstream files that are
//          never reformatted. The editor, the pre-commit hook and CI all read this one file.
// Boundary: formatter options and ignores only; adding an ignore pattern needs a reason beside it.
// Runtime: node
// Governing contract: Stackra ADR 0007 (docblocks wrap at the same width); stackra-15 (the
//                     generated examples are not reformatted)
{
  "$schema": "https://unpkg.com/oxfmt@0.71.0/configuration_schema.json",
  "printWidth": 100,
  "overrides": [
    {
      // Editors' JSON-with-comments services warn on a trailing comma; JSONC files carry none.
      "files": ["**/*.jsonc"],
      "options": { "trailingComma": "none" }
    },
    {
      // Prose wraps at printWidth, so the 100-column rule holds for docs too (.markdownlint.yaml MD013).
      "files": ["**/*.md", "**/*.mdx"],
      "options": { "proseWrap": "always" }
    }
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    // generated by stackra gen, never hand-formatted
    "**/.stackra/gen/**",
    // theme CSS rendered by @stackra/tokens (renderWebCss, renderNativeCss); a test compares it byte
    // for byte with the renderer's output, so formatting it would break that test
    "**/assets/public/themes/**",
    // Expo: generated native projects and the CLI cache
    "**/ios/**",
    "**/android/**",
    "**/.expo/**",
    // generated by tools
    "**/CHANGELOG.md",
    "pnpm-lock.yaml",
    // rendered from .mcp.yaml by `stackra mcp sync` (gitignored)
    ".mcp.json",
    // the examples' files exactly as `stackra new` writes them; .github/scripts/example-drift.mjs
    // holds them byte-equal to the cli template, so formatting them would fail that check
    "services/example/{package.json,tsconfig.json,turbo.jsonc,README.md,AGENTS.md}",
    "packages/application/example/{package.json,tsconfig.json,turbo.jsonc,README.md,AGENTS.md}"
  ]
}
