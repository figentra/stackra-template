// Stackra file contract:
// Purpose: the Renovate policy for this repository: which dependency updates are proposed, when,
//          and grouped how. Versions move in pnpm-workspace.yaml catalogs, mise.toml and the
//          `packageManager` field, never in a member's package.json (catalogMode: strict).
// Boundary: update policy only. No token, `hostRules` entry or registry credential: registry access
//           is configured in the Renovate app settings of the organisation. Nothing merges on its own;
//           every update is a pull request a human reviews against the Quality Gate.
// Runtime: node
// Governing contract: Stackra ADR 0013 (versions only from catalogs), Stackra ADR 0019 (supply-chain
//                     hardening). Runbook: https://docs.stackra.figentra.com/runbooks/renovate
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Recommended defaults plus digest pinning: actions by full commit SHA with the version in a
  // trailing comment, container images by digest.
  extends: ["config:best-practices", "helpers:pinGitHubActionDigestsToSemver"],
  // Branches start with `renovate/`; the Quality Gate skips commit-message linting on them because a
  // bot writes those messages.
  branchPrefix: "renovate/",
  // Conventional commits, e.g. `chore(deps): update dependency vitest to v5.0.6`.
  semanticCommits: "enabled",
  semanticCommitType: "chore",
  semanticCommitScope: "deps",
  labels: ["dependencies"],
  // A release must be a day old before it is proposed, as a blocking check, so a compromised release
  // has time to be pulled (pnpm-workspace.yaml `minimumReleaseAge` enforces the same at install).
  minimumReleaseAge: "1 day",
  internalChecksFilter: "strict",
  automerge: false,
  // The lockfile is refreshed weekly, outside working hours.
  lockFileMaintenance: { enabled: true, schedule: ["before 6am on monday"] },
  // A security advisory does not wait for the release age or the schedule.
  vulnerabilityAlerts: { minimumReleaseAge: null, labels: ["dependencies", "security"] },
  packageRules: [
    {
      // The framework moves as one version line; its releases are ours, so they skip the age gate.
      matchPackageNames: ["@stackra/**"],
      groupName: "stackra",
      minimumReleaseAge: null,
    },
    {
      // HeroUI Pro is a licensed beta line: every bump is reviewed by hand against its changelog.
      matchPackageNames: ["@heroui-pro/**"],
      groupName: "heroui pro",
      automerge: false,
    },
    {
      // Expo SDK packages move together, with `expo install --fix`; a new SDK major is a planned
      // upgrade, never an automatic pull request.
      matchPackageNames: ["expo", "expo-*", "react-native"],
      groupName: "expo sdk",
    },
    {
      matchPackageNames: ["expo", "expo-*", "react-native"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      // The toolchain moves together: mise.toml pins, .node-version and the packageManager field.
      matchManagers: ["mise", "nodenv"],
      groupName: "toolchain",
    },
    {
      matchDepNames: ["pnpm"],
      groupName: "toolchain",
    },
    {
      // Every GitHub Action in one weekly pull request.
      matchManagers: ["github-actions"],
      groupName: "github actions",
      schedule: ["before 6am on monday"],
    },
  ],
}
