# Stackra file contract:
# Purpose: what git never tracks. Everything under a member's .stackra/ is rebuilt by `stackra gen`
#          except the two committed contract artefacts, app-manifest.json and openapi.json (ADR
#          0158). The same rule set is repeated in each member's .gitignore so a member folder
#          copied elsewhere keeps it.
# Boundary: ignore rules only. No .env files exist in a Stackra project (ADR 0173): nothing to
#           ignore, nothing to leak; the guard-paths hook refuses to write one.
# Runtime: node
# Governing contract: ADR 0091, 0261 (gen output is derived), ADR 0158 d1, ADR 0268 (amended), ADR
#                     0173
.DS_Store
node_modules/
dist/
build/
coverage/
.turbo/
*.tsbuildinfo
*.log
.stackra/*
!.stackra/app-manifest.json
!.stackra/openapi.json
# template only: the generated samples are committed so they can be read; a real project drops the
# next line
!.stackra/**
test-results/
playwright-report/
maestro-report/
.lighthouseci/
.wrangler/
# Expo: native projects are generated by `expo prebuild`
.expo/
ios/
android/
# Mintlify local preview cache
.mintlify/
# Vite local overrides
*.local
# pnpm content-addressable cache if a tool points it here
.cache/
.pnpm-store/
# editor state
*.code-workspace
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
# Claude Code worktrees and per-user settings
.claude/worktrees/
.claude/settings.local.json
# rendered from .mcp.yaml by `stackra mcp sync` (run by `prepare`)
.mcp.json
# template only: a real project commits pnpm-lock.yaml (Release skips until it does)
pnpm-lock.yaml
