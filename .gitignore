# Stackra file contract:
# Purpose: what git never tracks. Everything under a member's .stackra/ is rebuilt by `stackra gen`
#          except the two committed contract artefacts, app-manifest.json and openapi.json (Stackra
#          ADR 0158). Each member's .gitignore repeats the rules that apply to it, so a member folder
#          copied elsewhere keeps them.
# Boundary: ignore rules only. A Stackra project has no .env files (Stackra ADR 0173: values live in
#           the secret store); they are ignored anyway as a second safeguard beside the guard hook.
# Runtime: node
# Governing contract: Stackra ADR 0091 and 0261 (gen output is derived), Stackra ADR 0158 (committed
#                     contracts), Stackra ADR 0173 (secrets never in files)

# Operating-system and editor droppings.
.DS_Store
Thumbs.db
*.swp
# Installed dependencies and the pnpm store, if a tool points it here.
node_modules/
.pnpm-store/
.cache/
# Build output and caches of tsdown, Vite, Turborepo and TypeScript.
dist/
build/
.turbo/
*.tsbuildinfo
# Test coverage and test-runner reports (Vitest, Playwright, Maestro, Lighthouse CI).
coverage/
test-results/
playwright-report/
maestro-report/
.maestro/output/
.lighthouseci/
# Logs from any tool.
*.log
# stackra gen output, except the two committed contracts.
.stackra/*
!.stackra/app-manifest.json
!.stackra/openapi.json
# Template only, while the stackra CLI is unpublished: the generated samples are committed so they can
# be read beside their source. Remove this line from the root and every member's .gitignore in one
# change once `stackra gen` runs.
!.stackra/**
# React Router typegen output (apps/web).
.react-router/
# Wrangler's local state and its local secret file (secrets come from the store, never a file).
.wrangler/
.dev.vars
# Environment files: never used, ignored so one can never be committed by mistake.
.env
.env.*
# Expo: native projects generated by `expo prebuild`, the CLI cache, and built binaries.
.expo/
ios/
android/
*.ipa
*.apk
*.aab
# Signing material: certificates, keys and provisioning profiles live in EAS and the secret store.
*.p8
*.p12
*.pem
*.jks
*.keystore
*.mobileprovision
# Mintlify local preview cache.
.mintlify/
# Vite local overrides.
*.local
# Editor state: only the shared VS Code files below are committed.
*.code-workspace
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
# Claude Code worktrees and per-user settings.
.claude/worktrees/
.claude/settings.local.json
# Rendered from .mcp.yaml by `stackra mcp sync` (run by `prepare`).
.mcp.json
# The release SBOM, written by `pnpm sbom` in CI and uploaded from there.
sbom.cdx.json
