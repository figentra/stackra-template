# generated by stackra gen from .gitignore (root and every app member) and the app members whose
# stackra.config.ts `targets` include ios or android — do not edit
# Stackra file contract:
# Purpose: what an EAS upload leaves out. EAS reads only this file, at the repository root, and when
#          it exists it ignores every .gitignore, so the repository ignores are repeated here and the
#          folders a native build never reads are added.
# Boundary: upload rules only. A mobile member's `.stackra/` folder and its root shims are gitignored
#           yet are the build's input (the Expo config, eas.json, Metro, the entry, the generated
#           code), so the `.stackra/*` ignore rules are not copied and the last block re-includes
#           them. `packages/**` stays: the app imports the workspace packages.
# Runtime: node
# Governing contract: ADR 0158 (gen artefacts), ADR 0180 (mobile apps and release trains)

# ── Repository ignores (root .gitignore), without its `.stackra/*` rules
.DS_Store
node_modules/
dist/
build/
coverage/
.turbo/
*.tsbuildinfo
*.log
test-results/
playwright-report/
maestro-report/
.lighthouseci/
.wrangler/
.mintlify/
*.local
.cache/
.pnpm-store/
.mcp.json

# ── Native projects: EAS runs `expo prebuild` on the worker from the Expo config
.expo/
ios/
android/

# ── Editor, agent and repository tooling a build never reads
*.code-workspace
.idea/
.vscode/
.claude/
.agents/
.notes/
.github/
.changeset/

# ── Members a mobile build never compiles: every app without a mobile target, and every service
apps/console/
apps/docs/
apps/web/
services/

# ── Gen output of each mobile member: gitignored, but the build reads it
!apps/mobile/.stackra/**
!apps/mobile/app.config.ts
!apps/mobile/metro.config.js
!apps/mobile/eas.json
