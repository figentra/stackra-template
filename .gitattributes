# Stackra file contract:
# Purpose: line endings and diff behaviour git applies before any tool sees a file.
# Boundary: git attributes only; ignore rules live in .gitignore.
# Runtime: node
# Governing contract: Stackra ADR 0158 (committed contract artefacts)

# Text files are stored and checked out with LF on every platform.
* text=auto eol=lf

# The lockfile is committed but never reviewed line by line.
pnpm-lock.yaml -diff
# Changesets appends to changelogs; a union merge keeps both sides of a concurrent release.
**/CHANGELOG.md merge=union
# stackra gen output. The committed manifest and OpenAPI file are the contracts consumers build
# from; GitHub folds them in diffs and language statistics. The `.stackra/gen` samples are committed
# while the CLI is unpublished (.gitignore) and are folded the same way.
**/.stackra/gen/** -diff linguist-generated
**/.stackra/app-manifest.json linguist-generated
**/.stackra/openapi.json linguist-generated

# Binary assets: never normalised, never diffed as text.
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
