# Stackra file contract:
# Purpose: line endings and diff behaviour git applies before any tool sees a file
# Owner: docs-governance
# Secrets: forbidden

* text=auto eol=lf

# Lockfiles and generated artefacts: keep, never review line-by-line
pnpm-lock.yaml -diff
**/CHANGELOG.md merge=union
# stackra gen output (committed only in the template; gitignored in a real repo) and the committed contracts it writes
**/.stackra/gen/** -diff linguist-generated
**/.stackra/app-manifest.json linguist-generated
**/.stackra/openapi.json linguist-generated

# Binary
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
