          "web": "src/blocks/welcome-hero/welcome-hero.tsx"
        },
        "props": {
          "$ref": "#/schemas/console.WelcomeHeroBlock"
        }
      }
    ],
    "stores": [
      {
        "key": "console.ui",
        "class": "UiStore",
        "file": "src/stores/ui.store.ts",
        "persist": "prefs"
      },
      {
        "key": "console.palette",
        "class": "PaletteStore",
        "file": "src/stores/palette.store.ts"
