        "permission": "orders.order.create",
        "flag": "orders.quick_order",
        "group": "orders::nav.sales"
      },
      {
        "key": "action.orders.order.create@1",
        "from": "commerce orders.order.create@1 (AppMenu m.action)",
        "permission": "orders.order.create",
        "flag": "orders.quick_order",
        "group": "orders::nav.sales"
      }
    ],
    "intents": [
      "orders.order.create@1",
      "orders.order.list@1",
      "catalogue.product.archive@1",
      "catalogue.variant.get_by_barcode@1",
