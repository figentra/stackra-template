  "schemas": {
    "console.DevicePrefs": {
      "type": "object",
      "required": ["scheme", "locale", "density", "localNotifications", "analyticsConsent"],
      "properties": {
        "scheme": {
          "$ref": "@stackra/theming#/schemas/ColorScheme",
          "default": "system"
        },
        "locale": {
          "$ref": "@stackra/i18n#/schemas/Locale",
          "default": "en"
        },
        "density": {
          "enum": ["comfortable", "compact"],
          "default": "comfortable"
        },
        "localNotifications": {
          "type": "boolean",
          "default": false
        },
        "analyticsConsent": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "console.QuickOrderForm": {
      "allOf": [
        {
          "$ref": "services/commerce/stackra.manifest.json#/schemas/orders.CreateOrderInput",
          "x-stackra-pick": ["lines"]
        }
      ],
      "properties": {
        "redeemPoints": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "console.TenantSettings": {
      "x-stackra-settings": [
        "orders.autoCancelAfterMinutes",
        "orders.customersMayCancel",
        "inventory.lowStockThreshold",
        "inventory.allowBackorders"
      ]
    },
    "console.WelcomeHeroAction": {
      "type": "object",
      "required": ["labelKey", "route"],
      "properties": {
        "labelKey": {
          "$ref": "@stackra/i18n#/schemas/I18nKey"
        },
        "route": {
          "type": "string",
          "x-stackra-field": "RouteKey: a key of the generated Routes"
        }
      }
    },
    "console.WelcomeHeroBlock": {
      "type": "object",
      "required": ["titleKey", "bodyKey"],
      "properties": {
        "titleKey": {
          "$ref": "@stackra/i18n#/schemas/I18nKey"
        },
        "bodyKey": {
          "$ref": "@stackra/i18n#/schemas/I18nKey"
        },
        "action": {
          "$ref": "#/schemas/console.WelcomeHeroAction"
        }
      }
    },
    "console.TelemetryErrors": {
      "type": "object",
      "required": ["enabled", "sampleRate", "replayOnError", "replayConsent"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "sampleRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "replayOnError": {
          "type": "boolean"
        },
        "replayConsent": {
          "$ref": "@stackra/consent#/schemas/ConsentCategory"
        }
      }
    },
    "console.VitalsBudgets": {
      "type": "object",
      "required": ["lcpMs", "inpMs", "cls"],
      "properties": {
        "lcpMs": {
          "type": "integer",
          "minimum": 1
        },
        "inpMs": {
          "type": "integer",
          "minimum": 1
        },
        "cls": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "console.TelemetryVitals": {
      "type": "object",
      "required": ["enabled", "budgets"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "budgets": {
          "$ref": "#/schemas/console.VitalsBudgets"
        }
      }
    },
    "console.BundleBudgets": {
      "type": "object",
      "required": ["entryKb", "routeKb"],
      "properties": {
        "entryKb": {
          "type": "integer",
          "minimum": 1
        },
        "routeKb": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "console.TelemetryTraces": {
      "type": "object",
      "required": ["sampleRate"],
      "properties": {
        "sampleRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
