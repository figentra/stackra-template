{
  "$comment": "GENERATED by stackra gen, COMMITTED at the member root (ADR 0294 decision 10). The member contract of the console: the gateway reads `consumes` (which actions, queries and events the app may call), every member reads `ui.panels` (which areas the console hosts), and the desktop release reads `bridges`. It locks every identity, derived or written: route, layout, panel, menu, shortcut, store, block, document and config keys, and the shapes' qualified names; a changed identity fails `stackra gen --check` unless the class carries @Renamed (ADR 0294 decision 22). Complete, never an excerpt.",
  "member": "console",
  "package": "@acme/console",
  "version": "0.1.0",
  "kind": "app",
  "targets": ["web", "pwa", "desktop"],
  "area": "app",
  "root": {
    "class": "ConsoleModule",
    "file": "src/console.module.ts",
    "wrap": []
  },
  "consumes": [
    {
      "service": "commerce",
      "manifest": "services/commerce/stackra.manifest.json",
      "uses": [
        "orders.order.create@1",
        "orders.order.cancel@1",
        "orders.order.get@1",
        "orders.order.list@1",
        "orders.order.stats_today@1",
        "catalogue.product.create@1",
        "catalogue.product.update@1",
        "catalogue.product.archive@1",
        "catalogue.product.attach_image@1",
        "catalogue.product.get@1",
        "catalogue.product.list@1",
        "catalogue.variant.search@1",
        "catalogue.variant.get_by_barcode@1",
        "inventory.stock.list_low@1",
        "loyalty_kit.account.enroll@1",
        "loyalty_kit.account.freeze@1",
        "loyalty_kit.points.redeem@1",
        "loyalty_kit.loyalty_account.list@1",
        "loyalty_kit.loyalty_account.get@1",
        "loyalty_kit.points.balance@1",
        "loyalty_kit.points.stats_today@1",
        "access_log.access_log_entry.list@1",
        "access_log.access_log_entry.get@1"
      ],
      "events": ["orders.order.paid.v1", "inventory.stock.low.v1", "loyalty_kit.points.earned.v2"]
    },
    {
      "service": "notifications",
      "manifest": "services/notifications/stackra.manifest.json",
      "uses": ["messages.notification.list@1", "messages.notification.mark_read@1"],
      "events": ["messages.notification.created.v1"]
    },
    {
      "service": "experience",
      "pin": "stackra.lock.yaml#experience",
      "uses": ["experience.document.get"]
    },
    {
      "service": "platform",
      "pin": "stackra.lock.yaml#platform",
      "uses": ["settings.value.set"]
    },
    {
      "service": "identity",
      "pin": "stackra.lock.yaml#identity",
      "uses": ["identity.session.current"]
    }
  ],
  "ui": {
    "panels": [
      {
        "key": "tenant_admin",
        "class": "TenantAdminPanel",
        "file": "src/panels/tenant-admin.panel.ts",
        "path": "/",
        "area": "admin"
      },
      {
        "key": "customer_portal",
        "class": "CustomerPortalPanel",
        "file": "src/panels/customer-portal.panel.ts",
        "path": "/portal",
        "area": "app"
      }
    ],
    "errorBoundary": "src/app.error.tsx",
    "layouts": [
      {
        "key": "shell",
        "class": "ShellLayout",
        "file": "src/routes/shell/shell.layout.ts",
        "component": "src/routes/shell/shell.tsx",
        "targets": ["web", "pwa", "desktop"],
        "loader": true,
        "tabs": ["dashboard", "quick_order", "settings"]
      },
      {
        "key": "public",
        "class": "PublicLayout",
        "file": "src/routes/public/public.layout.ts",
        "component": "src/routes/public/public.tsx"
      }
    ],
    "routes": [
      {
        "key": "dashboard",
        "class": "DashboardRoute",
        "file": "src/routes/dashboard/dashboard.route.ts",
        "path": "/",
        "layout": "shell",
        "component": "src/routes/dashboard/dashboard.tsx",
        "title": "console::pages.dashboard",
        "tab": {
          "order": 1,
          "icon": "house"
        },
        "loader": true,
        "queries": ["orders.order.stats_today@1"],
        "permission": "orders.order.read",
        "derived": ["permission"],
        "shadows": "panel.tenant_admin.index"
      },
      {
        "key": "quick_order",
        "class": "QuickOrderRoute",
        "file": "src/routes/quick-order/quick-order.route.ts",
        "path": "/quick-order",
        "layout": "shell",
        "component": "src/routes/quick-order/quick-order.tsx",
        "title": "orders::quick_order.title",
        "tab": {
          "order": 2,
          "icon": "bolt"
        },
        "flag": "orders.quick_order",
        "submit": true,
        "actions": ["orders.order.create@1"],
        "permission": "orders.order.create",
        "derived": ["permission"]
      },
      {
        "key": "settings",
        "class": "SettingsRoute",
        "file": "src/routes/settings/settings.route.ts",
        "path": "/settings",
        "layout": "shell",
        "component": "src/routes/settings/settings.tsx",
        "title": "console::pages.settings",
        "tab": {
          "order": 3,
          "icon": "gear"
        },
        "loader": true,
        "submit": true,
        "actions": ["settings.value.set"]
      },
      {
        "key": "welcome",
        "class": "WelcomeRoute",
        "file": "src/routes/welcome/welcome.route.ts",
        "path": "/welcome",
        "layout": "shell",
        "document": "console.welcome",
        "title": "console::documents.welcome.title"
      },
      {
        "key": "open",
        "class": "OpenRoute",
        "file": "src/routes/open/open.route.ts",
        "path": "/open",
        "layout": "shell",
        "loader": true,
        "search": ["url"],
        "deps": ["PwaConfig", "DesktopConfig"]
      },
      {
        "key": "sign_in",
        "class": "SignInRoute",
        "file": "src/routes/sign-in/sign-in.route.ts",
        "path": "/login",
        "layout": "public",
        "component": "src/routes/sign-in/sign-in.tsx",
        "title": "console::login.title",
        "auth": false,
        "loader": true,
        "search": ["returnTo"]
      },
      {
        "key": "not_found",
        "class": "NotFoundRoute",
        "file": "src/routes/not-found/not-found.route.ts",
        "path": "*",
        "layout": "shell",
        "component": "src/routes/not-found/not-found.tsx",
        "title": "console::errors.not_found.title",
        "status": 404
      }
    ],
    "generatedRoutes": [
      {
        "from": "commerce catalogue.product (resource, admin)",
        "paths": [
          "/catalogue/products",
          "/catalogue/products/:id",
          "/catalogue/products/:id/edit",
          "/catalogue/products/new"
        ],
        "layout": "shell"
      },
      {
        "from": "commerce orders.order (resource, admin)",
        "paths": ["/orders/orders", "/orders/orders/:id"],
        "layout": "shell"
      },
      {
        "from": "commerce loyalty_kit.loyalty_account (resource, admin)",
        "paths": ["/loyalty/accounts", "/loyalty/accounts/:id", "/loyalty/accounts/new"],
        "layout": "shell"
      },
      {
        "from": "commerce access_log.access_log_entry (resource, admin)",
        "paths": ["/access-log/entries", "/access-log/entries/:id"],
        "layout": "shell"
      },
      {
        "from": "@stackra/queue queue.failed_job (resource, admin)",
        "paths": ["/queue/failed-jobs", "/queue/failed-jobs/:id"],
        "layout": "shell"
      },
      {
        "from": "commerce orders.sales_today (document, admin)",
        "paths": ["/sales"],
        "layout": "shell"
      },
      {
        "from": "commerce orders, inventory, loyalty_kit; notifications messages (settings pages)",
        "paths": [
          "/settings/orders",
          "/settings/inventory",
          "/settings/loyalty-kit",
          "/settings/messages"
        ],
        "layout": "shell"
      },
      {
        "from": "CustomerPortalPanel (panel, app area) with commerce loyalty_kit.loyalty_overview (document, app)",
        "paths": ["/portal", "/portal/loyalty"]
      }
    ],
    "documents": [
      {
        "key": "console.welcome",
        "class": "WelcomeDocument",
        "file": "src/documents/welcome.document.ts",
        "kind": "page",
        "area": "admin",
        "title": "console::documents.welcome.title",
        "permission": "orders.order.read",
