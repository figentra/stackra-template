      {
        "key": "console.cycle_theme",
        "class": "CycleThemeShortcut",
        "keys": "mod+shift+l",
        "group": "console::palette.group_app",
        "label": "console::shortcuts.cycle_theme.label"
      },
      {
        "key": "console.open_pending_changes",
        "class": "OpenPendingChangesShortcut",
        "group": "console::palette.group_app",
        "label": "console::shortcuts.open_pending_changes.label"
      },
      {
        "key": "console.sign_out",
        "class": "SignOutShortcut",
        "group": "console::palette.group_account",
        "label": "console::shortcuts.sign_out.label"
      }
    ],
    "generatedShortcuts": [
      {
        "key": "navigate.catalogue.products",
        "from": "commerce catalogue.product (resource navigation)",
        "permission": "catalogue.product.read",
        "group": "catalogue::nav.catalogue"
      },
      {
        "key": "navigate.orders.sales_today",
        "from": "commerce orders.sales_today (document navigation)",
        "permission": "orders.order.read",
        "group": "orders::nav.sales"
      },
      {
        "key": "navigate.orders.orders",
        "from": "commerce orders.order (resource navigation)",
        "permission": "orders.order.read",
        "group": "orders::nav.sales"
      },
      {
        "key": "navigate.settings.orders",
        "from": "commerce orders (settings page navigation)",
        "permission": "orders.settings.update",
        "group": "console::pages.settings"
      },
      {
        "key": "navigate.settings.inventory",
        "from": "commerce inventory (settings page navigation)",
        "permission": "inventory.settings.update",
        "group": "console::pages.settings"
      },
      {
        "key": "navigate.settings.messages",
