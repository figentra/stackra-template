      "required": ["labelKey", "route"],
      "properties": {
        "labelKey": {
          "$ref": "@stackra/i18n#/schemas/I18nKey"
        },
        "route": {
          "type": "string",
          "x-stackra-field": "RouteKey: a key of the generated Routes"
        }
      }
    },
    "console.WelcomeHeroBlock": {
      "type": "object",
      "required": ["titleKey", "bodyKey"],
      "properties": {
        "titleKey": {
          "$ref": "@stackra/i18n#/schemas/I18nKey"
        },
        "bodyKey": {
          "$ref": "@stackra/i18n#/schemas/I18nKey"
        },
        "action": {
          "$ref": "#/schemas/console.WelcomeHeroAction"
        }
      }
    },
    "console.TelemetryErrors": {
      "type": "object",
      "required": ["enabled", "sampleRate", "replayOnError", "replayConsent"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "sampleRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "replayOnError": {
          "type": "boolean"
