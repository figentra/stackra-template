{
  "name": "@acme/console",
  "version": "0.1.0",
  "private": true,
  "description": "The tenant console as web, PWA and desktop from one source tree. Kind classes (panels, routes, layouts, menus, shortcuts, stores, blocks, documents, config) found by their group folders declare the app, and its components are class components; stackra gen writes the entries, the wiring and the tool configs into .stackra/.",
  "license": "UNLICENSED",
  "type": "module",
  "imports": {
    "#src/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ],
    "#assets/*": "./assets/*",
    "#stackra-desktop/*": [
      "./.stackra/desktop/*",
      "./.stackra/desktop/*.ts",
      "./.stackra/desktop/*.tsx",
      "./.stackra/desktop/*/index.ts"
    ],
    "#stackra/*": [
      "./.stackra/gen/*",
      "./.stackra/gen/*.ts",
      "./.stackra/gen/*.tsx",
      "./.stackra/gen/*/index.ts"
    ]
  },
  "scripts": {
    "gen": "stackra gen",
    "dev": "stackra dev",
    "dev:desktop": "stackra dev --target desktop",
    "build": "stackra build",
    "typecheck": "stackra typecheck",
    "test": "stackra test",
    "test:e2e": "stackra test --tier e2e",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@acme/loyalty-kit": "workspace:*",
    "@acme/theme": "workspace:*",
    "@heroui-pro/react": "catalog:",
    "@heroui/styles": "catalog:ui",
    "@stackra/actions": "catalog:stackra",
    "@stackra/analytics": "catalog:stackra",
    "@stackra/app": "catalog:stackra",
    "@stackra/assets": "catalog:stackra",
    "@stackra/clients": "catalog:stackra",
    "@stackra/config": "catalog:stackra",
    "@stackra/consent": "catalog:stackra",
    "@stackra/container": "catalog:stackra",
    "@stackra/contracts": "catalog:stackra",
    "@stackra/coordinator": "catalog:stackra",
    "@stackra/csp": "catalog:stackra",
    "@stackra/errors": "catalog:stackra",
    "@stackra/experience": "catalog:stackra",
    "@stackra/feature-flags": "catalog:stackra",
    "@stackra/filesystem": "catalog:stackra",
    "@stackra/i18n": "catalog:stackra",
    "@stackra/iam": "catalog:stackra",
    "@stackra/icons": "catalog:stackra",
    "@stackra/identity": "catalog:stackra",
    "@stackra/logger": "catalog:stackra",
    "@stackra/media": "catalog:stackra",
    "@stackra/money": "catalog:stackra",
    "@stackra/navigation": "catalog:stackra",
    "@stackra/panel": "catalog:stackra",
    "@stackra/peripherals": "catalog:stackra",
    "@stackra/platform": "catalog:stackra",
    "@stackra/query": "catalog:stackra",
    "@stackra/realtime": "catalog:stackra",
    "@stackra/settings": "catalog:stackra",
    "@stackra/shortcuts": "catalog:stackra",
    "@stackra/state": "catalog:stackra",
    "@stackra/storage": "catalog:stackra",
    "@stackra/tenancy": "catalog:stackra",
    "@stackra/theming": "catalog:stackra",
    "@stackra/tokens": "catalog:stackra",
    "@stackra/ui": "catalog:stackra",
    "@stackra/validation": "catalog:stackra",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "tailwindcss": "catalog:frontend",
    "workbox-expiration": "catalog:frontend",
    "workbox-navigation-preload": "catalog:frontend",
    "workbox-precaching": "catalog:frontend",
    "workbox-routing": "catalog:frontend",
    "workbox-strategies": "catalog:frontend",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:quality",
    "@stackra/cli": "catalog:stackra",
    "@stackra/gen": "catalog:stackra",
    "@stackra/runway": "catalog:stackra",
    "@stackra/testing": "catalog:stackra",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vite-plugin": "catalog:stackra",
    "@stackra/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "electron": "catalog:build",
    "jsdom": "catalog:quality",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "typescript": "catalog:build",
    "vite": "catalog:build",
    "vitest": "catalog:quality"
  }
}
