{
  // Stackra file contract:
  // Purpose: TypeScript settings of the console; the app preset (DOM lib, JSX, legacy decorators, no emit), nothing local.
  // Boundary: `#src/*`, `#stackra/*` and `#stackra-desktop/*` resolve through package.json imports; `.stackra/` is
  //           included so generated code is checked. `src/bridges/**` is Electron-main code: the preset adds the node
  //           lib for that folder.
  // Runtime: node
  // Governing contract: ADR 0003 (one preset per member), ADR 0165, ADR 0005 (legacy decorators)
  "extends": "@stackra/typescript-config/app.json",
  "include": ["src", "stackra.config.ts", ".stackra"]
}
