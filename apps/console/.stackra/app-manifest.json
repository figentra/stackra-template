{
  "$comment": "generated by stackra gen from src/**/*.{route,layout,panel,menu,command,bridge,block,document,override}.ts(x), src/console.app.ts, stackra.config.ts and the #stackra/clients imports — do not edit. Committed: the gateway reads `consumes` and `bridges`; other members read `panels`.",
  "member": "@acme/console",
  "key": "console",
  "kind": "app",
  "targets": ["web", "pwa", "desktop"],
  "area": "app",
  "root": "ConsoleApp",
  "panels": [
    { "class": "TenantAdminPanel", "key": "tenant_admin", "path": "/", "realm": "staff" },
    {
      "class": "CustomerPortalPanel",
      "key": "customer_portal",
      "path": "/portal",
      "realm": "customer"
    }
  ],
  "consumes": [
    {
      "service": "commerce",
      "manifest": "services/commerce/.stackra/app-manifest.json",
      "uses": [
        "orders.order.create",
        "orders.order.cancel",
        "orders.order.get",
        "orders.order.list",
        "orders.order.stats_today",
        "catalogue.product.create",
        "catalogue.product.update",
        "catalogue.product.archive",
        "catalogue.product.attach_image",
        "catalogue.product.get",
        "catalogue.product.list",
        "catalogue.variant.search",
        "catalogue.variant.get_by_barcode",
        "inventory.stock.list_low"
      ],
      "events": ["orders.order.paid.v1", "inventory.stock.low"]
    },
    {
      "service": "notifications",
      "manifest": "services/notifications/.stackra/app-manifest.json",
      "uses": ["messages.notification.list", "messages.notification.mark_read"]
    },
    { "service": "experience", "pin": "stackra.lock.yaml#experience", "uses": ["experience.document.get"] },
    { "service": "platform", "pin": "stackra.lock.yaml#platform", "uses": ["settings.value.set"] },
    { "service": "identity", "pin": "stackra.lock.yaml#identity", "uses": ["identity.session.current"] }
  ],
  "providers": [
    {
      "class": "SessionProvider",
      "order": 10,
      "hydrate": true,
      "file": "src/providers/session/session.provider.ts"
    },
    {
      "class": "TenantProvider",
      "order": 20,
      "hydrate": true,
      "file": "src/providers/tenant/tenant.provider.ts"
    },
    {
      "component": "TenantQueryContextProvider",
      "file": "src/providers/tenant-query/tenant-query.context.tsx"
    },
    {
      "class": "RealtimeProvider",
      "order": 30,
      "hydrate": true,
      "file": "src/providers/realtime/realtime.provider.ts"
    },
    { "component": "FlagsContextProvider", "file": "src/providers/flags/flags.context.tsx" },
    { "component": "PlatformProvider", "package": "@stackra/platform/react" },
    { "component": "Toast.Provider", "package": "@stackra/ui" }
  ],
  "layouts": [
    {
      "class": "ShellLayout",
      "kind": "shell",
      "component": "Shell",
      "tabs": ["DashboardRoute", "QuickOrderRoute", "SettingsRoute"],
      "guard": true
    },
    { "class": "PublicLayout", "kind": "page", "component": "PublicFrame" }
  ],
  "routes": [
    {
      "class": "DashboardRoute",
      "key": "dashboard",
      "path": "/",
      "layout": "ShellLayout",
      "prefetch": ["orders.order.stats_today"],
      "permission": "orders.order.read",
      "derived": ["permission"],
      "staleTime": "30s",
      "component": "DashboardPage",
      "title": "console::pages.dashboard",
      "shadows": "panel.tenant_admin.index"
    },
    {
      "class": "QuickOrderRoute",
      "key": "quick_order",
      "path": "/quick-order",
      "layout": "ShellLayout",
      "flag": "orders.quick_order",
      "prefetch": ["catalogue.variant.search"],
      "submits": {
        "action": "orders.order.create",
        "form": "QuickOrderForm",
        "redirect": "Resources.Order.view"
      },
      "permission": "orders.order.create",
      "derived": ["permission"],
      "component": "QuickOrderPage",
      "title": "orders::quick_order.title"
    },
    {
      "class": "SettingsRoute",
      "key": "settings",
      "path": "/settings",
      "layout": "ShellLayout",
      "loader": true,
      "submit": true,
      "component": "SettingsPage",
      "title": "console::pages.settings"
    },
    {
      "class": "WelcomeRoute",
      "key": "welcome",
      "path": "/welcome",
      "layout": "ShellLayout",
      "document": "console.welcome",
      "title": "console::pages.welcome"
    },
    {
      "class": "OpenRoute",
      "key": "open",
      "path": "/open",
      "layout": "ShellLayout",
      "loader": true,
      "search": ["url"]
    },
    {
      "class": "SignInRoute",
      "key": "sign_in",
      "path": "/login",
      "layout": "PublicLayout",
      "auth": false,
      "loader": true,
      "component": "SignInPage",
      "title": "console::login.title"
    },
    {
      "class": "NotFoundRoute",
      "key": "not_found",
      "path": "*",
      "layout": "ShellLayout",
      "status": 404,
      "component": "NotFoundPage",
      "title": "console::errors.not_found.title"
    }
  ],
  "generatedRoutes": [
    {
      "from": "commerce catalogue.product (resource)",
      "paths": [
        "/catalogue/products",
        "/catalogue/products/:id",
        "/catalogue/products/:id/edit",
        "/catalogue/products/new"
      ],
      "layout": "ShellLayout"
    },
    {
      "from": "commerce orders.order (resource)",
      "paths": ["/orders/orders", "/orders/orders/:id"],
      "layout": "ShellLayout"
    },
    {
      "from": "commerce access_log.access_log_entry (resource)",
      "paths": ["/access-log/entries", "/access-log/entries/:id"],
      "layout": "ShellLayout"
    },
    {
      "from": "@stackra/queue queue.failed_job (resource)",
      "paths": ["/queue/failed-jobs", "/queue/failed-jobs/:id"],
      "layout": "ShellLayout"
    },
    {
      "from": "commerce orders.sales_today (document)",
      "paths": ["/sales"],
      "layout": "ShellLayout"
    },
    {
      "from": "commerce orders, inventory; notifications messages (settings pages)",
      "paths": ["/settings/orders", "/settings/inventory", "/settings/messages"],
      "layout": "ShellLayout"
    },
    {
      "from": "CustomerPortalPanel (panel)",
      "paths": ["/portal", "/portal/orders/orders", "/portal/orders/orders/:id"]
    }
  ],
  "documents": [
    {
      "class": "WelcomeDocument",
      "key": "console.welcome",
      "panels": ["tenant_admin"],
      "permission": "orders.order.read",
      "blocks": [
        "console.welcome_hero",
        "widget:orders.revenue_today",
        "widget:inventory.low_stock"
      ]
    }
  ],
  "blocks": [
    {
      "class": "WelcomeHeroBlock",
      "key": "console.welcome_hero",
      "component": "WelcomeHero",
      "props": "WelcomeHeroProps"
    }
  ],
  "stores": [
    { "class": "UiStore", "key": "console.ui", "persist": "prefs" },
    { "class": "CommandPaletteStore", "key": "console.command_palette" }
  ],
  "commands": [
    {
      "key": "console.palette.open",
      "class": "OpenPaletteCommand",
      "shortcut": "mod+k",
      "group": "console::commands.group_app"
    },
    {
      "key": "console.sidebar.toggle",
      "class": "ToggleSidebarCommand",
      "shortcut": "mod+b",
      "group": "console::commands.group_app"
    },
    {
      "key": "console.theme.cycle",
      "class": "CycleThemeCommand",
      "shortcut": "mod+shift+l",
      "group": "console::commands.group_app"
    },
    {
      "key": "console.queue.open",
      "class": "OpenPendingChangesCommand",
      "group": "console::commands.group_app"
    },
    {
      "key": "console.session.logout",
      "class": "SignOutCommand",
      "group": "console::commands.group_account"
    },
    {
      "key": "navigate.catalogue.products",
      "from": "commerce catalogue.product (resource navigation)",
      "permission": "catalogue.product.read",
      "group": "catalogue::nav.catalogue"
    },
    {
      "key": "navigate.orders.orders",
      "from": "commerce orders.order (resource navigation)",
      "permission": "orders.order.read",
      "group": "orders::nav.sales"
    },
    {
      "key": "navigate.orders.sales_today",
      "from": "commerce orders.sales_today (document navigation)",
      "permission": "orders.order.read",
      "group": "orders::nav.sales"
    },
    {
      "key": "navigate.settings.orders",
      "from": "commerce orders (settings page navigation)",
      "permission": "settings.value.manage",
      "group": "console::pages.settings"
    },
    {
      "key": "navigate.settings.inventory",
      "from": "commerce inventory (settings page navigation)",
      "permission": "settings.value.manage",
      "group": "console::pages.settings"
    },
    {
      "key": "navigate.settings.messages",
      "from": "notifications messages (settings page navigation, user scope)",
      "group": "console::pages.settings"
    },
    {
      "key": "navigate.queue.failed_jobs",
      "from": "@stackra/queue queue.failed_job (resource navigation)",
      "group": "console::pages.settings"
    },
    {
      "key": "navigate.access_log.entries",
      "from": "commerce access_log.access_log_entry (resource navigation)",
      "permission": "access_log.access_log_entry.read",
      "group": "access_log::nav.audit"
    },
    {
      "key": "navigate.console.quick_order",
      "from": "QuickOrderRoute (AppMenu m.route)",
      "shortcut": "mod+shift+o",
      "permission": "orders.order.create",
      "flag": "orders.quick_order",
      "group": "orders::nav.sales"
    },
    {
      "key": "action.orders.order.create",
      "from": "commerce orders.order.create (AppMenu m.action)",
      "permission": "orders.order.create",
      "flag": "orders.quick_order",
      "group": "orders::nav.sales"
    }
  ],
  "intents": [
    "orders.order.create",
    "orders.order.list",
    "catalogue.product.archive",
    "catalogue.variant.get_by_barcode",
    "catalogue.variant.search"
  ],
  "menus": [
    { "class": "AppMenu", "kind": "application", "targets": ["desktop"] },
    { "class": "TrayMenu", "kind": "tray", "targets": ["desktop"] },
    { "class": "ContextMenu", "kind": "context", "targets": ["desktop"] }
  ],
  "bridges": [
    {
      "key": "console.receipt.print",
      "class": "PrintReceiptBridge",
      "permission": "orders.order.read",
      "risk": "l1",
      "actors": ["user"],
      "capability": "print",
      "input": "PrintReceiptInput",
      "output": "PrintReceiptOutput"
    },
    {
      "key": "console.export.pick_folder",
      "class": "PickExportFolderBridge",
      "permission": "orders.order.read",
      "risk": "l0",
      "actors": ["user"],
      "capability": "files_save",
      "input": "PickExportFolderInput",
      "output": "PickExportFolderOutput"
    }
  ],
  "overrides": [
    {
      "class": "OrderStatusBadgeOverride",
      "point": "orders.order_status_badge",
      "file": "src/overrides/orders/components/order-status-badge.override.tsx"
    },
    {
      "class": "RevenueSparklineOverride",
      "point": "orders.revenue_sparkline",
      "file": "src/overrides/orders/components/revenue-sparkline.override.tsx"
    }
  ],
  "config": [
    "console.env",
    "console.i18n",
    "console.theming",
    "console.pwa",
    "console.desktop",
    "console.csp",
    "console.query",
    "console.state",
    "console.telemetry",
    "console.identity",
    "console.flags",
    "console.analytics",
    "console.consent",
    "console.peripherals"
  ],
  "secrets": [],
  "assets": { "lang": { "console": ["en", "ar"] }, "public": ["console::public/logo.svg"] }
}
