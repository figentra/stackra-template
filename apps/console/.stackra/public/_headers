# generated by stackra gen from stackra.config.ts (appLinks) and the console's /.well-known/ files
# — do not edit
# Purpose: response headers of the static files the console's Worker serves from its assets.
# Boundary: Cloudflare Workers static assets read this file from the build root. The association
#           files are answered as JSON (the Apple one has no extension, so it would not be by
#           default) and never cached for long, so a rotated signing key or team reaches the phones
#           within the hour; they are served directly, with no redirect, as Apple and Google require.
# Runtime: worker
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600
/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: public, max-age=3600
