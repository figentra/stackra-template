{
  "$comment": "generated by stackra gen from src/config/pwa.config.ts (manifest), src/config/theming.config.ts, src/config/i18n.config.ts, assets/public/logo.svg, assets/lang/en/console.json (shell.brand, shortcuts.quick_order) — do not edit",
  "id": "/",
  "name": "Figentra Console",
  "short_name": "Console",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone"],
  "orientation": "any",
  "categories": ["business", "productivity"],
  "background_color": "#f7f7f5",
  "theme_color": "#1c1e22",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    {
      "src": "/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Quick order",
      "url": "/quick-order",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "protocol_handlers": [{ "protocol": "web+figentra", "url": "/open?url=%s" }],
  "launch_handler": { "client_mode": "navigate-existing" }
}
