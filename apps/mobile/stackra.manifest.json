{
  "$comment": "GENERATED by stackra gen, COMMITTED at the member root (ADR 0294 decision 10). The member contract of the mobile app: the services and modules it consumes, its `ui` (routes, layouts, documents, blocks, stores, menus and lang overrides), its refusals, analytics events, config classes and environment. It locks every identity, derived or written; a changed identity fails `stackra gen --check` unless the class or field carries @Renamed (ADR 0294 decision 22). An app serves no HTTP, so no openapi.json sits beside it. Complete, never an excerpt.",
  "member": "mobile",
  "package": "@acme/mobile",
  "version": "0.1.0",
  "kind": "app",
  "targets": ["ios", "android"],
  "area": "app",
  "root": {
    "class": "MobileModule",
    "file": "src/mobile.module.ts",
    "wrap": []
  },
  "modules": [
    {
      "key": "identity",
      "service": "identity",
      "dependsOn": []
    },
    {
      "key": "devices",
      "service": "identity",
      "dependsOn": ["identity"]
    },
    {
      "key": "catalogue",
      "service": "commerce",
      "dependsOn": ["inventory"],
      "entitlement": "commerce.catalogue"
    },
    {
      "key": "orders",
      "service": "commerce",
      "dependsOn": ["catalogue", "inventory"],
      "entitlement": "commerce.orders"
    },
    {
      "key": "messages",
      "service": "notifications",
      "dependsOn": []
    },
    {
      "key": "experience",
      "service": "experience",
      "dependsOn": []
    }
  ],
  "consumes": [
    {
      "service": "commerce",
      "manifest": "services/commerce/stackra.manifest.json",
      "modules": ["catalogue", "orders"]
    },
    {
      "service": "notifications",
      "manifest": "services/notifications/stackra.manifest.json",
      "modules": ["messages"]
    },
    {
      "service": "identity",
      "manifest": "acme-platform services/identity/stackra.manifest.json",
      "pin": "stackra.lock.yaml#identity",
      "modules": ["identity", "devices"]
    },
    {
      "service": "experience",
      "manifest": "acme-platform services/experience/stackra.manifest.json",
      "pin": "stackra.lock.yaml#experience",
      "modules": ["experience"]
    }
  ],
  "ui": {
    "layouts": [
      {
        "key": "tabs",
        "class": "TabsLayout",
        "file": "src/routes/tabs/tabs.layout.ts",
        "children": ["home", "orders", "settings"],
        "loader": true,
        "deps": ["PreferencesStore", "TenantSwitcher"]
      }
    ],
    "routes": [
      {
        "key": "home",
        "class": "HomeRoute",
        "file": "src/routes/home/home.route.ts",
        "component": "src/routes/home/home.tsx",
        "path": "/",
        "layout": "tabs",
        "tab": {
          "order": 1,
          "icon": "house"
        },
        "chrome": {
          "header": "large"
        },
        "title": "mobile::routes.home.title"
      },
      {
        "key": "orders",
        "class": "OrdersRoute",
        "file": "src/routes/orders/orders.route.ts",
        "component": "src/routes/orders/orders.tsx",
        "path": "/orders",
        "layout": "tabs",
        "params": "mobile.OrdersFilter",
        "permission": "orders.order.read",
        "tab": {
          "order": 2,
          "icon": "package"
        },
        "chrome": {
          "header": "large"
        },
        "title": "mobile::routes.orders.title"
      },
      {
        "key": "settings",
        "class": "SettingsRoute",
        "file": "src/routes/settings/settings.route.ts",
        "component": "src/routes/settings/settings.tsx",
        "path": "/settings",
        "layout": "tabs",
        "tab": {
          "order": 3,
          "icon": "settings"
        },
        "chrome": {
          "header": "large"
        },
        "title": "mobile::routes.settings.title"
      },
      {
        "key": "order_detail",
        "class": "OrderDetailRoute",
        "file": "src/routes/order-detail/order-detail.route.ts",
        "component": "src/routes/order-detail/order-detail.tsx",
        "path": "/orders/:orderId",
        "params": "mobile.OrderDetailParams",
        "loader": ["orders.order.get@1"],
        "permission": "orders.order.read",
        "permissionFrom": "loader",
        "cache": {
          "ttl": "1h"
        },
        "title": "mobile::routes.order_detail.title"
      },
      {
        "key": "create_order",
        "class": "CreateOrderRoute",
        "file": "src/routes/create-order/create-order.route.ts",
        "component": "src/routes/create-order/create-order.tsx",
        "path": "/orders/new",
        "params": "mobile.CreateOrderParams",
        "permission": "orders.order.create",
        "presentation": "sheet",
        "title": "mobile::routes.create_order.title"
      },
      {
        "key": "scan",
        "class": "ScanRoute",
        "file": "src/routes/scan/scan.route.ts",
        "component": "src/routes/scan/scan.tsx",
        "path": "/scan",
        "permission": "catalogue.product.read",
        "flag": "orders.quick_order",
        "presentation": "full_screen",
        "capability": {
          "scanner": "required"
        },
        "title": "mobile::routes.scan.title"
      },
      {
        "key": "announcements",
        "class": "AnnouncementsRoute",
        "file": "src/routes/announcements/announcements.route.ts",
        "component": "src/routes/announcements/announcements.tsx",
        "path": "/announcements",
        "document": "mobile.announcements",
        "cache": {
          "ttl": "1h"
        },
        "title": "mobile::routes.announcements.title"
      },
      {
        "key": "inbox",
        "class": "InboxRoute",
        "file": "src/routes/inbox/inbox.route.ts",
        "component": "src/routes/inbox/inbox.tsx",
        "path": "/inbox",
        "title": "mobile::routes.inbox.title"
      },
      {
        "key": "notification_preferences",
        "class": "NotificationPreferencesRoute",
        "file": "src/routes/notification-preferences/notification-preferences.route.ts",
        "component": "src/routes/notification-preferences/notification-preferences.tsx",
        "path": "/settings/notifications",
        "settings": "messages",
        "title": "mobile::routes.notification_preferences.title"
      },
      {
        "key": "profile",
        "class": "ProfileRoute",
        "file": "src/routes/profile/profile.route.ts",
        "component": "src/routes/profile/profile.tsx",
        "path": "/profile",
        "title": "mobile::routes.profile.title"
      },
      {
        "key": "sign_in",
        "class": "SignInRoute",
        "file": "src/routes/sign-in/sign-in.route.ts",
        "component": "src/routes/sign-in/sign-in.tsx",
        "auth": false,
        "chrome": {
          "header": "hidden"
        },
        "title": "mobile::routes.sign_in.title"
      }
    ],
    "documents": [
      {
        "key": "mobile.announcements",
        "class": "AnnouncementsDocument",
        "file": "src/documents/announcements.document.ts",
        "kind": "page",
        "layout": "stack",
        "title": "mobile::documents.announcements.title",
        "blocks": ["mobile.promo_banner", "widget:orders.revenue_today"]
      }
    ],
    "blocks": [
      {
        "key": "mobile.promo_banner",
        "class": "PromoBannerBlock",
        "file": "src/blocks/promo-banner/promo-banner.block.ts",
        "renderer": "src/blocks/promo-banner/promo-banner.tsx",
        "category": "marketing",
        "icon": "megaphone",
        "props": "mobile.PromoBannerBlock"
      }
    ],
    "stores": [
      {
        "key": "mobile.preferences",
        "class": "PreferencesStore",
        "file": "src/stores/preferences.store.ts",
        "persist": "prefs",
        "fields": ["tenantByUser"]
      }
    ],
    "menus": [
      {
        "key": "mobile.order_card",
        "class": "OrderCardMenu",
        "file": "src/menus/order-card.menu.ts",
        "kind": "context",
        "items": ["route:order_detail", "action:orders.order.cancel@1"]
      },
      {
        "key": "mobile.tab_bar",
        "class": "TabBarMenu",
        "file": "src/menus/tab-bar.menu.ts",
        "kind": "tab_bar",
        "items": ["tabs"]
      }
    ],
    "overrides": [
      {
        "kind": "lang",
        "namespace": "orders",
        "file": "assets/overrides/orders/<locale>.json",
        "locales": ["en", "ar"],
        "keys": ["actions.order.cancel.confirm"]
      }
    ]
  },
  "errors": [
    {
      "code": "session_required",
      "class": "SessionRequiredError",
      "file": "src/errors/session-required.error.ts",
      "kind": "failed_precondition",
      "category": "precondition_failed",
      "retryable": false,
      "message": "mobile::errors.session_required.message"
    }
  ],
  "analyticsEvents": [
    {
      "name": "scan.barcode_scanned",
      "class": "BarcodeScanned",
      "file": "src/analytics/barcode-scanned.analytics-event.ts",
      "fields": ["found"],
      "consent": "analytics"
    }
  ],
  "config": [
    {
      "key": "mobile.env",
      "class": "MobileEnvConfig",
      "file": "src/config/env.config.ts"
    },
    {
      "key": "navigation.chrome",
      "base": "ChromeConfig",
      "class": "MobileChromeConfig",
      "file": "src/config/chrome.config.ts"
    },
    {
      "key": "i18n",
      "base": "I18nConfig",
      "class": "MobileI18nConfig",
      "file": "src/config/i18n.config.ts"
    },
    {
      "key": "theming",
      "base": "ThemingConfig",
      "class": "MobileThemingConfig",
      "file": "src/config/theming.config.ts"
    },
    {
      "key": "identity",
      "base": "IdentityConfig",
      "class": "MobileIdentityConfig",
      "file": "src/config/identity.config.ts"
    },
    {
      "key": "query",
      "base": "QueryConfig",
      "class": "MobileQueryConfig",
      "file": "src/config/query.config.ts"
    },
    {
      "key": "state",
      "base": "StateConfig",
      "class": "MobileStateConfig",
      "file": "src/config/state.config.ts"
    },
    {
      "key": "logger.telemetry",
      "base": "TelemetryConfig",
      "class": "MobileTelemetryConfig",
      "file": "src/config/telemetry.config.ts"
    },
    {
      "key": "platform.push",
      "base": "PushConfig",
      "class": "MobilePushConfig",
      "file": "src/config/push.config.ts"
    },
    {
      "key": "realtime",
      "base": "RealtimeConfig",
      "class": "MobileRealtimeConfig",
      "file": "src/config/realtime.config.ts"
    },
    {
      "key": "analytics",
      "base": "AnalyticsConfig",
      "class": "MobileAnalyticsConfig",
      "file": "src/config/analytics.config.ts"
    },
    {
      "key": "consent",
      "base": "ConsentConfig",
      "class": "MobileConsentConfig",
      "file": "src/config/consent.config.ts"
    },
    {
      "key": "feature_flags",
      "base": "FeatureFlagsConfig",
      "class": "MobileFeatureFlagsConfig",
      "file": "src/config/feature-flags.config.ts"
    }
  ],
  "env": {
    "class": "MobileEnvConfig",
    "public": [
      {
        "name": "EXPO_PUBLIC_EAS_PROJECT_ID",
        "config": "mobile.env",
        "field": "easProjectId"
      },
      {
        "name": "EXPO_PUBLIC_API_ORIGIN",
        "config": "mobile.env",
        "field": "apiOrigin"
      },
      {
        "name": "EXPO_PUBLIC_APP_ORIGIN",
        "config": "mobile.env",
        "field": "appOrigin"
      },
      {
        "name": "EXPO_PUBLIC_REALTIME_ORIGIN",
        "config": "realtime",
        "field": "origin"
      },
      {
        "name": "EXPO_PUBLIC_ZITADEL_ISSUER",
        "config": "identity",
        "field": "issuer"
      },
      {
        "name": "EXPO_PUBLIC_ZITADEL_CLIENT_ID",
        "config": "identity",
        "field": "clientId"
      },
      {
        "name": "EXPO_PUBLIC_SENTRY_DSN",
        "config": "logger.telemetry",
        "field": "dsn"
      },
      {
        "name": "EXPO_PUBLIC_PUSH_PROVIDER",
        "config": "platform.push",
        "field": "provider"
      },
      {
        "name": "EXPO_PUBLIC_POSTHOG_KEY",
        "config": "analytics",
        "field": "posthogKey"
      },
      {
        "name": "EXPO_PUBLIC_POSTHOG_KEY",
        "config": "feature_flags",
        "field": "posthogKey"
      }
    ]
  },
  "capabilities": {
    "required": ["scanner", "network", "secureStore", "browser", "appState"],
    "optional": ["push", "updates"]
  },
  "e2e": {
    "flows": "src/routes/**/__tests__/*.flow.yaml",
    "profile": "e2e",
    "seeds": ["orders.demo"],
    "locales": ["en", "ar"]
  },
  "enums": [
    {
      "key": "mobile.consent_category",
      "class": "ConsentCategory",
      "file": "src/enums/consent-category.enum.ts",
      "codes": ["necessary", "analytics", "crash_replay"]
    },
    {
      "key": "mobile.cta_verb",
      "class": "CtaVerb",
      "file": "src/enums/cta-verb.enum.ts",
      "codes": ["navigate", "action"]
    }
  ],
  "schemas": [
    "mobile.OrderDetailParams",
    "mobile.CreateOrderParams",
    "mobile.OrdersFilter",
    "mobile.CreateOrderForm",
    "mobile.PromoBannerCta",
    "mobile.NavigateEvent",
    "mobile.ActionEvent",
    "mobile.PromoBannerBlock",
    "mobile.BarcodeScanned",
    "mobile.PreferencesStore"
  ]
}
