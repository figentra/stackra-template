{
  "name": "@acme/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "The mobile app for iOS and Android: Expo with code-based React Navigation; routes, layouts, menus, blocks, documents, stores and config overrides are kind classes found by their group folders, pages and components are class components, and stackra gen writes the entry, the navigation tree and every tool file into .stackra/.",
  "license": "UNLICENSED",
  "main": ".stackra/entry/native.ts",
  "imports": {
    "#src/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ],
    "#assets/*": "./assets/*",
    "#stackra/*": [
      "./.stackra/gen/*",
      "./.stackra/gen/*.ts",
      "./.stackra/gen/*.tsx",
      "./.stackra/gen/*/index.ts"
    ]
  },
  "scripts": {
    "gen": "stackra gen",
    "dev": "stackra dev",
    "dev:ios": "stackra dev --target ios",
    "dev:android": "stackra dev --target android",
    "build": "stackra build",
    "typecheck": "stackra typecheck",
    "test": "stackra test",
    "test:e2e": "stackra test --tier e2e",
    "doctor": "stackra doctor",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist .expo .turbo maestro-report"
  },
  "dependencies": {
    "@acme/theme": "workspace:*",
    "@bottom-tabs/react-navigation": "catalog:mobile",
