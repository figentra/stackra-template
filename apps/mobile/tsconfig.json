{
  // Stackra file contract:
  // Purpose: TypeScript settings of the mobile app: exactly one role preset, nothing local.
  // Boundary: the mobile preset owns the compiler options (react-native condition, JSX, legacy
  //           decorators, no emit) and the include list through `${configDir}` (`src`,
  //           `stackra.config.ts` and the generated `.stackra/`); `#src/*` and `#stackra/*` resolve
  //           through package.json imports.
  // Runtime: node
  // Governing contract: ADR 0003 (one preset per member), ADR 0005 (legacy decorators), ADR 0061
  "extends": "@stackra/typescript-config/mobile"
}
