{
  "$comment": "generated by stackra gen from src/**/*.route.ts, *.layout.ts, *.block.ts, *.document.ts, *.menu.ts, overrides/** and #stackra/clients imports — COMMITTED (ADR 0158); the one contract source of this app",
  "member": "@figentra/mobile",
  "key": "mobile",
  "version": "0.1.0",
  "targets": ["ios", "android"],
  "area": "app",
  "modules": ["identity", "devices", "catalogue", "orders", "messages", "experience"],
  "consumes": [
    {
      "service": "commerce",
      "manifest": "services/commerce/.stackra/app-manifest.json",
      "modules": ["orders", "catalogue"]
    },
    {
      "service": "notifications",
      "manifest": "services/notifications/.stackra/app-manifest.json",
      "modules": ["messages"]
    },
    {
      "service": "identity",
      "manifest": "figentra-os services/identity/.stackra/app-manifest.json",
      "pin": "stackra-manifests.lock.yaml#identity@2d4f6c8",
      "modules": ["devices"]
    },
    {
      "service": "experience",
      "manifest": "figentra-os services/experience/.stackra/app-manifest.json",
      "pin": "stackra-manifests.lock.yaml#experience@b82d913",
      "modules": ["experience"]
    }
  ],
  "panels": ["tenant_admin"],
  "routes": [
    {
      "key": "home",
      "class": "HomeRoute",
      "path": "/",
      "index": true,
      "layout": "tabs",
      "auth": true,
      "tab": true,
      "component": "HomePage"
    },
    {
      "key": "orders",
      "class": "OrdersRoute",
      "path": "/orders",
      "layout": "tabs",
      "auth": true,
      "tab": true,
      "permission": "orders.order.read",
      "params": "OrdersFilter",
      "component": "OrdersPage"
    },
    {
      "key": "settings",
      "class": "SettingsRoute",
      "path": "/settings",
      "layout": "tabs",
      "auth": true,
      "tab": true,
      "component": "SettingsPage"
    },
    {
      "key": "order_detail",
      "class": "OrderDetailRoute",
      "path": "/orders/:orderId",
      "auth": true,
      "permission": "orders.order.read",
      "permissionFrom": "prefetch",
      "params": "OrderDetailParams",
      "presentation": "card",
      "prefetch": ["orders.order.get"],
      "cache": {
        "ttl": "1h"
      },
      "component": "OrderDetailPage"
    },
    {
      "key": "create_order",
      "class": "CreateOrderRoute",
      "path": "/orders/new",
      "auth": true,
      "permission": "orders.order.create",
      "params": "CreateOrderParams",
      "presentation": "form_sheet",
      "component": "CreateOrderPage"
    },
    {
      "key": "scan",
      "class": "ScanRoute",
      "path": "/scan",
      "auth": true,
      "permission": "catalogue.product.read",
      "flag": "orders.quick_order",
      "presentation": "full_screen_modal",
      "capability": {
        "scanner": "required"
      },
      "component": "ScanPage"
    },
    {
      "key": "announcements",
      "class": "AnnouncementsRoute",
      "path": "/announcements",
      "auth": true,
      "presentation": "card",
      "document": "mobile.announcements",
      "cache": {
        "ttl": "1h"
      },
      "component": "DocumentPage"
    },
    {
      "key": "inbox",
      "class": "InboxRoute",
      "path": "/inbox",
      "auth": true,
      "presentation": "card",
      "component": "InboxPage"
    },
    {
      "key": "notification_preferences",
      "class": "NotificationPreferencesRoute",
      "path": "/settings/notifications",
      "auth": true,
      "presentation": "card",
      "settings": "messages",
      "component": "NotificationPreferencesPage"
    },
    {
      "key": "profile",
      "class": "ProfileRoute",
      "path": "/profile",
      "auth": true,
      "presentation": "card",
      "component": "ProfilePage"
    },
    {
      "key": "sign_in",
      "class": "SignInRoute",
      "auth": false,
      "presentation": "card",
      "component": "SignInPage"
    }
  ],
  "layouts": [
    {
      "key": "tabs",
      "class": "TabsLayout",
      "kind": "native_tabs",
      "tabs": ["home", "orders", "settings"],
      "guard": true,
      "targets": ["ios", "android"]
    }
  ],
  "providers": [
    {
      "class": "TenantProvider",
      "order": 20,
      "hydrate": true
    },
    {
      "class": "RealtimeProvider",
      "order": 30,
      "hydrate": true
    },
    {
      "class": "PushProvider",
      "order": 40,
      "hydrate": true
    }
  ],
  "stores": [
    {
      "key": "preferences",
      "class": "PreferencesStore",
      "persist": "prefs"
    }
  ],
  "blocks": [
    {
      "key": "mobile.promo_banner",
      "class": "PromoBannerBlock",
      "props": "PromoBannerProps",
      "targets": ["ios", "android"]
    }
  ],
  "documents": [
    {
      "key": "mobile.announcements",
      "class": "AnnouncementsDocument",
      "panels": ["tenant_admin"],
      "blocks": ["mobile.promo_banner", "widget:orders.revenue_today"]
    }
  ],
  "overrides": [
    {
      "kind": "component",
      "point": "orders.revenue_sparkline",
      "class": "RevenueSparklineOverride",
      "file": "src/overrides/orders/components/revenue-sparkline.override.tsx"
    },
    {
      "kind": "lang",
      "namespace": "orders",
      "locales": ["en", "ar"],
      "keys": ["order.cancel_confirm"]
    }
  ],
  "capabilities": {
    "required": ["scanner", "network", "secureStore", "browser", "appState"],
    "optional": ["push", "updates"]
  },
  "env": {
    "class": "MobileEnv",
    "public": [
      "EXPO_PUBLIC_EAS_PROJECT_ID",
      "EXPO_PUBLIC_API_ORIGIN",
      "EXPO_PUBLIC_APP_ORIGIN",
      "EXPO_PUBLIC_REALTIME_ORIGIN",
      "EXPO_PUBLIC_ZITADEL_ISSUER",
      "EXPO_PUBLIC_ZITADEL_CLIENT_ID",
      "EXPO_PUBLIC_SENTRY_DSN",
      "EXPO_PUBLIC_PUSH_PROVIDER",
      "EXPO_PUBLIC_POSTHOG_KEY"
    ]
  },
  "configKeys": [
    "mobile.env",
    "mobile.i18n",
    "mobile.theming",
    "mobile.identity",
    "mobile.query",
    "mobile.state",
    "mobile.telemetry",
    "mobile.push",
    "mobile.release",
    "mobile.realtime",
    "mobile.analytics",
    "mobile.consent",
    "mobile.flags"
  ],
  "e2e": {
    "flows": "src/routes/__tests__/*.flow.yaml",
    "profile": "e2e",
    "seeds": ["orders.demo"],
    "locales": ["en", "ar"]
  },
  "menus": [
    {
      "class": "OrderCardMenu",
      "kind": "context",
      "targets": ["ios", "android"],
      "items": ["route:order_detail", "action:orders.order.cancel"]
    }
  ],
  "analytics": [
    {
      "name": "scan.barcode_scanned",
      "class": "BarcodeScanned",
      "consent": "analytics"
    }
  ]
}
