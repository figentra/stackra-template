// Purpose: the EAS build and submit profiles. Every build profile sets STACKRA_ENVIRONMENT to the
//          runway environment its EAS environment is synced from, and .stackra/app.config.ts fails
//          an EAS build without it. Submit profiles share the store build profiles' names.
// Boundary: a `ref:` value is resolved by `stackra build` and `stackra release` when they copy this
//           file to the member root for the EAS CLI, so the CLI never reads one. Comments are `//`
//           lines, never a `$comment` key: eas-cli validates the root against its schema, which
//           refuses unknown keys, and reads a file that is not strict JSON as JSON5.
// Runtime: node (eas-cli, from mise.toml)
// Governing contract: Stackra ADR 0180 (mobile release), ADR 0173 (EAS environments synced by
//                     runway), ADR 0295 (decisions 4 and 5)
{
  "cli": { "version": "25.3.0", "appVersionSource": "remote" },
  "build": {
    "base": { "node": "24.22.0", "pnpm": "12.6.0" },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true },
      "channel": "development",
      "environment": "development",
      "env": { "STACKRA_ENVIRONMENT": "dev" }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "channel": "preview",
      "environment": "preview",
      "env": { "STACKRA_ENVIRONMENT": "preview" }
    },
    "staging": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true,
      "channel": "staging",
      "environment": "staging",
      "env": { "STACKRA_ENVIRONMENT": "staging" }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "env": { "STACKRA_ENVIRONMENT": "production" }
    },
    "e2e": {
      "extends": "base",
      "distribution": "internal",
      "ios": { "simulator": true, "buildConfiguration": "Release" },
      "android": { "buildType": "apk" },
      "channel": "e2e",
