{
  "$comment": "generated by stackra gen from runway.yaml (release.mobile.profiles, release.mobile.submit, environments.<env>.mobile.channel), mise.toml (node, pnpm), src/config/release.config.ts (appVersionSource) — do not edit; copied to the member root for the EAS CLI",
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "base": { "node": "24", "pnpm": "12.6.0" },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true },
      "channel": "development",
      "environment": "development"
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "channel": "preview",
      "environment": "preview"
    },
    "staging": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true,
      "channel": "staging",
      "environment": "staging"
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true,
      "channel": "production",
      "environment": "production"
    },
    "e2e": {
      "extends": "base",
      "distribution": "internal",
      "ios": { "simulator": true, "buildConfiguration": "Release" },
      "android": { "buildType": "apk" },
      "channel": "e2e",
      "environment": "preview"
    }
  },
  "submit": { "production": { "ios": {}, "android": {} } }
}
