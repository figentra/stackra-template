{
  "$comment": "generated by stackra gen from runway.yaml (release.mobile.profiles, release.mobile.submit, environments.<env>.mobile.channel), the root runway.yaml (providers.apple.ascAppId, targets.eas.storeRollout), mise.toml (node, pnpm, npm:eas-cli) and src/config/release.config.ts (appVersionSource) — do not edit. Every build profile sets STACKRA_ENVIRONMENT to the runway environment its EAS environment is synced from, and .stackra/app.config.ts fails an EAS build without it. Submit profiles share the store build profiles' names. A `ref:` value is resolved by `stackra build` and `stackra release` when they copy this file to the member root for the EAS CLI, so the CLI never reads one.",
  "cli": { "version": "25.3.0", "appVersionSource": "remote" },
  "build": {
    "base": { "node": "24.22.0", "pnpm": "12.6.0" },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true },
      "channel": "development",
      "environment": "development",
      "env": { "STACKRA_ENVIRONMENT": "dev" }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "channel": "preview",
      "environment": "preview",
      "env": { "STACKRA_ENVIRONMENT": "preview" }
    },
    "staging": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true,
      "channel": "staging",
      "environment": "staging",
      "env": { "STACKRA_ENVIRONMENT": "staging" }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "env": { "STACKRA_ENVIRONMENT": "production" }
    },
    "e2e": {
      "extends": "base",
      "distribution": "internal",
      "ios": { "simulator": true, "buildConfiguration": "Release" },
      "android": { "buildType": "apk" },
      "channel": "e2e",
      "environment": "preview",
      "env": { "STACKRA_ENVIRONMENT": "preview" }
    }
  },
  "submit": {
    "staging": {
      "ios": { "ascAppId": "ref:apple.ascAppId" },
      "android": { "track": "internal", "releaseStatus": "completed" }
    },
    "production": {
      "ios": { "ascAppId": "ref:apple.ascAppId" },
      "android": { "track": "production", "releaseStatus": "inProgress", "rollout": 0.1 }
    }
  }
}
