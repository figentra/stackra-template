{
  "name": "@acme/web",
  "version": "0.1.0",
  "private": true,
  "description": "The public site: landing, pricing, storefront and tenant pages. React Router 7 framework mode on a Cloudflare Worker, declared with kind classes (routes, the site layout, blocks, menus, flags, an analytics event, config) and class components found by their group folders; stackra gen writes the entries, the wiring and the tool configs into .stackra/.",
  "license": "UNLICENSED",
  "type": "module",
  "imports": {
    "#src/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ],
    "#assets/*": "./assets/*",
    "#stackra/*": [
      "./.stackra/gen/*",
      "./.stackra/gen/*.ts",
      "./.stackra/gen/*.tsx",
      "./.stackra/gen/*/index.ts"
    ]
  },
  "scripts": {
    "gen": "stackra gen",
    "dev": "stackra dev",
    "build": "stackra build",
    "start": "stackra start",
    "typecheck": "stackra typecheck",
    "test": "stackra test",
    "test:e2e": "stackra test --tier e2e",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@acme/theme": "workspace:*",
    "@heroui/styles": "catalog:ui",
    "@stackra/analytics": "catalog:stackra",
    "@stackra/app": "catalog:stackra",
    "@stackra/assets": "catalog:stackra",
    "@stackra/cache": "catalog:stackra",
    "@stackra/clients": "catalog:stackra",
    "@stackra/config": "catalog:stackra",
    "@stackra/consent": "catalog:stackra",
    "@stackra/container": "catalog:stackra",
    "@stackra/content": "catalog:stackra",
    "@stackra/contracts": "catalog:stackra",
    "@stackra/csp": "catalog:stackra",
    "@stackra/errors": "catalog:stackra",
    "@stackra/events": "catalog:stackra",
    "@stackra/experience": "catalog:stackra",
    "@stackra/feature-flags": "catalog:stackra",
    "@stackra/i18n": "catalog:stackra",
    "@stackra/iam": "catalog:stackra",
    "@stackra/icons": "catalog:stackra",
    "@stackra/logger": "catalog:stackra",
    "@stackra/media": "catalog:stackra",
    "@stackra/money": "catalog:stackra",
    "@stackra/navigation": "catalog:stackra",
    "@stackra/platform": "catalog:stackra",
    "@stackra/seo": "catalog:stackra",
    "@stackra/state": "catalog:stackra",
    "@stackra/theming": "catalog:stackra",
    "@stackra/tokens": "catalog:stackra",
    "@stackra/ui": "catalog:stackra",
    "@stackra/validation": "catalog:stackra",
    "isbot": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "tailwindcss": "catalog:frontend",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@lhci/cli": "catalog:quality",
    "@playwright/test": "catalog:quality",
    "@react-router/dev": "catalog:build",
    "@stackra/cli": "catalog:stackra",
    "@stackra/gen": "catalog:stackra",
    "@stackra/runway": "catalog:stackra",
    "@stackra/testing": "catalog:stackra",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vite-plugin": "catalog:stackra",
    "@stackra/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:quality",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "typescript": "catalog:build",
    "vite": "catalog:build",
    "vitest": "catalog:quality"
  }
}
