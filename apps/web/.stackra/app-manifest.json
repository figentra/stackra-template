{
  "$comment": "generated by stackra gen from src/**/*.{route,layout,block,menu,flag}.ts, src/web.app.ts, stackra.config.ts and the #stackra/clients imports — do not edit. Committed: the gateway reads `consumes`.",
  "member": "@figentra/web",
  "key": "web",
  "kind": "app",
  "targets": ["web_ssr"],
  "area": "public",
  "root": "WebApp",
  "consumes": [
    {
      "service": "commerce",
      "manifest": "services/commerce/.stackra/app-manifest.json",
      "uses": [
        "catalogue.product.list_storefront",
        "catalogue.product.search",
        "catalogue.product.get_by_slug"
      ]
    },
    { "service": "billing", "revision": "8e1b3d2", "uses": ["billing.catalog.plan.list"] },
    { "service": "content", "revision": "4a9c7f1", "uses": ["content.entry.list"] },
    {
      "service": "experience",
      "revision": "b82d913",
      "uses": [
        "sites.site.resolve",
        "sites.site.get",
        "experience.document.get",
        "pages.sitemap.get",
        "seo.redirect.resolve",
        "seo.not_found.record"
      ]
    },
    { "service": "marketing", "revision": "c3d8e07", "uses": ["leads.lead.create"] }
  ],
  "providers": [
    {
      "component": "SiteContextProvider",
      "from": "SiteLayout",
      "file": "src/providers/site/site.context.tsx"
    },
    { "component": "Toast.Provider", "package": "@stackra/ui" }
  ],
  "layouts": [
    {
      "class": "SiteLayout",
      "kind": "site",
      "component": "SiteFrame",
      "resolve": true,
      "errorBoundary": "RouteError"
    }
  ],
  "routes": [
    {
      "class": "LandingRoute",
      "key": "landing",
      "path": "/",
      "index": true,
      "layout": "SiteLayout",
      "prerender": true,
      "cache": "marketing",
      "loader": true,
      "meta": true,
      "component": "LandingPage"
    },
    {
      "class": "PricingRoute",
      "key": "pricing",
      "path": "/pricing",
      "layout": "SiteLayout",
      "prerender": true,
      "cache": "marketing",
      "loader": true,
      "meta": true,
      "flags": ["web.pricing_yearly_first"],
      "component": "PricingPage"
    },
    {
      "class": "ContactRoute",
      "key": "contact",
      "path": "/contact",
      "layout": "SiteLayout",
      "prerender": true,
      "cache": "marketing",
      "submit": true,
      "meta": true,
      "component": "ContactPage"
    },
    {
      "class": "StoreRoute",
      "key": "store",
      "path": "/store",
      "layout": "SiteLayout",
      "cache": "catalogue",
      "loader": true,
      "meta": true,
      "component": "StorePage"
    },
    {
      "class": "ProductRoute",
      "key": "product",
      "path": "/store/:slug",
      "layout": "SiteLayout",
      "cache": "catalogue",
      "loader": true,
      "meta": true,
      "component": "ProductPage"
    },
    {
      "class": "PageRoute",
      "key": "page",
      "path": "*",
      "layout": "SiteLayout",
      "render": "client",
      "fallback": "TenantPageFallback",
      "cache": "page",
      "loader": true,
      "meta": true,
      "component": "TenantPage"
    }
  ],
  "generatedRoutes": [
    {
      "from": "seo.config.ts",
      "paths": ["/robots.txt", "/sitemap.xml", "/sitemaps/:source", "/og/:kind/:id"]
    },
    {
      "from": "i18n.config.ts urlStrategy prefix_except_default",
      "locales": { "en": "/", "ar": "/ar" }
    }
  ],
  "menus": [{ "class": "SiteMenu", "kind": "navigation" }],
  "flags": [
    {
      "class": "PricingYearlyFirstFlag",
      "key": "web.pricing_yearly_first",
      "default": false,
      "owner": "web",
      "expires": "2027-03-31"
    }
  ],
  "analyticsEvents": [{ "class": "LeadSubmitted", "name": "lead.submitted" }],
  "blocks": [
    {
      "class": "HeroSectionBlock",
      "key": "web.hero",
      "component": "HeroSection",
      "props": "HeroProps"
    },
    {
      "class": "FeatureGridBlock",
      "key": "web.feature_grid",
      "component": "FeatureGrid",
      "props": "FeatureGridProps"
    },
    {
      "class": "PricingTableBlock",
      "key": "web.pricing_table",
      "component": "PricingTable",
      "props": "PricingTableProps",
      "accepts": "billing.catalog.plan.list"
    },
    {
      "class": "TestimonialsBlock",
      "key": "web.testimonials",
      "component": "Testimonials",
      "props": "TestimonialsProps",
      "accepts": "content.entry.list"
    },
    {
      "class": "FaqSectionBlock",
      "key": "web.faq",
      "component": "FaqSection",
      "props": "FaqProps",
      "accepts": "content.entry.list"
    },
    { "class": "CtaBannerBlock", "key": "web.cta", "component": "CtaBanner", "props": "CtaProps" },
    {
      "class": "ProductGridBlock",
      "key": "web.product_grid",
      "component": "ProductGrid",
      "props": "ProductGridProps",
      "accepts": "catalogue.product.list_storefront"
    }
  ],
  "overrides": [
    {
      "lang": "leads",
      "locale": "en",
      "keys": ["refusals.rate_limited", "refusals.captcha_failed"],
      "file": "src/overrides/leads/lang/en.json"
    },
    {
      "lang": "leads",
      "locale": "ar",
      "keys": ["refusals.rate_limited", "refusals.captcha_failed"],
      "file": "src/overrides/leads/lang/ar.json"
    }
  ],
  "config": [
    "web.env",
    "web.i18n",
    "web.theming",
    "web.site",
    "web.seo",
    "web.consent",
    "web.analytics",
    "web.flags",
    "web.telemetry",
    "web.edge",
    "web.csp"
  ],
  "secrets": ["TURNSTILE_SECRET_KEY"],
  "assets": { "lang": { "web": ["en", "ar"] }, "public": ["web::public/logo.svg"] }
}
