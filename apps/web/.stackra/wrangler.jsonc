// generated by stackra gen from stackra.config.ts (key, env class), runway.yaml
// (environments.<env>: domain, aliases, vars, workers) and root runway.yaml
// (targets.cloudflare-workers, providers.cloudflare) — do not edit
// Purpose: the Worker that serves the site: entry, static assets from the client build, server
//          vars per environment, the custom domain and its aliases.
// Boundary: secret values are never here: runway syncs them from Infisical on deploy (ADR 0173)
//           and the Worker reads them from `env`. Secret names are listed for the reviewer only.
// Runtime: node
{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "acme-web",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "../build/client", "binding": "ASSETS" },
  // Only the server fields of WebEnv (STACKRA_*) are Worker vars; VITE_* fields are inlined.
  // Secrets (names only, from runway.yaml `secrets`): TURNSTILE_SECRET_KEY
  "env": {
    "preview": {
      // runway.yaml environments.preview; `${pr}` is filled by the deploy job
      "vars": {
        "STACKRA_API_URL": "https://api-pr-${pr}.preview.acme.dev",
        "STACKRA_SITE_URL": "https://web-pr-${pr}.preview.acme.dev",
        "STACKRA_SENTRY_DSN": "ref:sentry.dsn.web",
      },
      "routes": [{ "pattern": "web-pr-${pr}.preview.acme.dev", "custom_domain": true }],
      "observability": { "enabled": true, "head_sampling_rate": 1 },
    },
    "staging": {
      "vars": {
        "STACKRA_API_URL": "https://api.staging.acme.dev",
        "STACKRA_SITE_URL": "https://staging.acme.dev",
        "STACKRA_SENTRY_DSN": "ref:sentry.dsn.web",
      },
      "routes": [{ "pattern": "staging.acme.dev", "custom_domain": true }],
      "observability": { "enabled": true, "head_sampling_rate": 0.5 },
    },
    "production": {
      "vars": {
        "STACKRA_API_URL": "https://api.acme.dev",
        "STACKRA_SITE_URL": "https://www.acme.dev",
        "STACKRA_SENTRY_DSN": "ref:sentry.dsn.web",
      },
      "routes": [
        { "pattern": "www.acme.dev", "custom_domain": true },
        // alias: the Worker redirects it to `domain`
        { "pattern": "acme.dev", "custom_domain": true },
      ],
      "observability": { "enabled": true, "head_sampling_rate": 0.1 },
      "limits": { "cpu_ms": 50 },
    },
  },
}
