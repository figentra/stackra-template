// generated by stackra gen from stackra.config.ts (member key, env class), runway.yaml
// (environments.<env>: domain, aliases, vars, workers) and root runway.yaml
// (targets.cloudflare-workers, providers.cloudflare) — do not edit
// Purpose: the Worker that serves the site: the entry, static assets from the client build with
//          the Worker run first for every page, server vars per environment, the custom domain
//          and its aliases.
// Boundary: secret values are never here: runway syncs them from the project's secret store on
//           deploy (ADR 0173) and the Worker reads them from `env`. Secret names are listed for the
//           reviewer only. Only `/assets/*` skips the Worker, so the guards, the CSP header and
//           the HTML cache rule cover every page.
// Runtime: node
// Governing contract: ADR 0175 (domains and aliases), ADR 0173 (secrets synced by runway), ADR 0297
//                     (decisions 1 and 2: web renders on Workers, run_worker_first)
{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "acme-web",
  "main": "./entry/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../build/client",
    "binding": "ASSETS",
    // every page request reaches the Worker; only the hashed build assets are served without it
    "run_worker_first": ["/*", "!/assets/*"]
  },
  // Only the server fields of WebEnvConfig (STACKRA_*) are Worker vars; VITE_* fields are inlined.
  // Secrets (names only, from runway.yaml `secrets`): TURNSTILE_SECRET_KEY,
  // GATEWAY_VISITOR_SIGNING_KEY
  "env": {
    "preview": {
      // runway.yaml environments.preview; `${pr}` is filled by the deploy job
      "vars": {
        "STACKRA_API_URL": "https://api-pr-${pr}.preview.acme.example",
        "STACKRA_SITE_URL": "https://web-pr-${pr}.preview.acme.example",
        "STACKRA_SENTRY_DSN": "ref:sentry.dsn.web"
      },
      "routes": [{ "pattern": "web-pr-${pr}.preview.acme.example", "custom_domain": true }],
      "observability": { "enabled": true, "head_sampling_rate": 1 }
    },
    "staging": {
      "vars": {
        "STACKRA_API_URL": "https://api.staging.acme.example",
        "STACKRA_SITE_URL": "https://staging.acme.example",
        "STACKRA_SENTRY_DSN": "ref:sentry.dsn.web"
      },
      "routes": [{ "pattern": "staging.acme.example", "custom_domain": true }],
      "observability": { "enabled": true, "head_sampling_rate": 0.5 }
    },
    "production": {
      "vars": {
        "STACKRA_API_URL": "https://api.acme.example",
        "STACKRA_SITE_URL": "https://www.acme.example",
        "STACKRA_SENTRY_DSN": "ref:sentry.dsn.web"
      },
      "routes": [
        { "pattern": "www.acme.example", "custom_domain": true },
        // alias: the Worker redirects it to `domain`
        { "pattern": "acme.example", "custom_domain": true }
      ],
      "observability": { "enabled": true, "head_sampling_rate": 0.1 },
      "limits": { "cpu_ms": 50 }
    }
  }
}
