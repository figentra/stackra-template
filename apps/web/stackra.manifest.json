{
  "$comment": "GENERATED by stackra gen, COMMITTED at the member root (ADR 0294 decision 10). The member contract of the public site: the gateway reads `consumes` (which public queries and actions the site may call), and the experience service reads `ui.blocks` (which blocks a tenant's documents may place). It locks every identity, derived or written: route, layout, menu, block, flag, analytics event and config keys, and the shapes' qualified names; a changed identity fails `stackra gen --check` unless the class carries @Renamed (ADR 0294 decision 22). Complete, never an excerpt.",
  "member": "web",
  "package": "@acme/web",
  "version": "0.1.0",
  "kind": "app",
  "targets": ["web", "pwa"],
  "render": "server",
  "area": "public",
  "root": {
    "class": "WebModule",
    "file": "src/web.module.ts",
    "wrap": []
  },
  "consumes": [
    {
      "service": "commerce",
      "manifest": "services/commerce/stackra.manifest.json",
      "uses": [
        "catalogue.product.list_storefront@1",
        "catalogue.product.search@1",
        "catalogue.product.get_by_slug@1"
      ]
    },
    {
      "service": "billing",
      "pin": "stackra.lock.yaml#billing",
      "uses": ["billing.catalog.plan.list"]
    },
    {
      "service": "content",
      "pin": "stackra.lock.yaml#content",
      "uses": ["content.entry.list"]
    },
    {
      "service": "experience",
      "pin": "stackra.lock.yaml#experience",
      "uses": [
        "sites.site.resolve",
        "sites.site.get",
        "experience.document.get",
        "pages.sitemap.get",
        "seo.redirect.resolve",
        "seo.not_found.record"
      ]
    },
    {
      "service": "marketing",
      "pin": "stackra.lock.yaml#marketing",
      "uses": ["leads.lead.create"]
    }
  ],
  "forwarding": {
    "$comment": "ADR 0297 decision 6: every call from the Worker carries these; the gateway verifies the signature with the same secret name.",
    "headers": ["traceparent", "Stackra-Visitor", "Sec-Purpose"],
    "signingSecret": "GATEWAY_VISITOR_SIGNING_KEY"
  },
  "ui": {
    "errorBoundary": "src/app.error.tsx",
    "layouts": [
      {
        "key": "site",
        "class": "SiteLayout",
        "file": "src/routes/site/site.layout.ts",
        "component": "src/routes/site/site.tsx",
        "loader": true,
        "queries": ["sites.site.resolve", "sites.site.get"],
        "cache": ["page"],
        "deps": ["SiteConfig", "I18nConfig"]
      }
    ],
    "routes": [
      {
        "key": "landing",
        "class": "LandingRoute",
        "file": "src/routes/landing/landing.route.ts",
        "path": "/",
        "layout": "site",
        "component": "src/routes/landing/landing.tsx",
        "seo": {
          "title": "web::hero.title"
        },
        "loader": true,
        "meta": true,
        "queries": ["billing.catalog.plan.list", "content.entry.list"],
        "cache": ["marketing"],
        "deps": ["SiteConfig"]
      },
      {
        "key": "pricing",
        "class": "PricingRoute",
        "file": "src/routes/pricing/pricing.route.ts",
        "path": "/pricing",
        "layout": "site",
        "component": "src/routes/pricing/pricing.tsx",
        "seo": {
          "title": "web::pricing.title"
        },
        "loader": true,
        "meta": true,
        "queries": ["billing.catalog.plan.list", "content.entry.list"],
        "cache": ["marketing"],
        "flags": ["web.pricing_yearly_first"],
        "derived": ["flags"],
        "deps": ["SiteConfig"]
      },
      {
        "key": "contact",
        "class": "ContactRoute",
        "file": "src/routes/contact/contact.route.ts",
        "path": "/contact",
        "layout": "site",
        "component": "src/routes/contact/contact.tsx",
        "seo": {
          "title": "web::contact.title"
        },
        "search": {
          "$ref": "#/schemas/web.ContactSearch"
        },
        "submit": true,
        "meta": true,
        "actions": ["leads.lead.create"]
      },
      {
        "key": "store",
        "class": "StoreRoute",
        "file": "src/routes/store/store.route.ts",
        "path": "/store",
        "layout": "site",
        "component": "src/routes/store/store.tsx",
        "seo": {
          "title": "web::store.title"
        },
        "search": {
          "$ref": "#/schemas/web.StoreSearch"
        },
        "loader": true,
        "meta": true,
        "queries": ["catalogue.product.search@1", "catalogue.product.list_storefront@1"],
        "cache": ["catalogue"],
        "deps": ["SeoConfig"]
      },
      {
        "key": "product",
        "class": "ProductRoute",
        "file": "src/routes/product/product.route.ts",
        "path": "/store/:slug",
        "layout": "site",
        "component": "src/routes/product/product.tsx",
        "loader": true,
        "meta": true,
        "queries": ["catalogue.product.get_by_slug@1"],
        "cache": ["catalogue"],
        "canonicalRedirect": true
      },
      {
        "key": "page",
        "class": "PageRoute",
        "file": "src/routes/page/page.route.ts",
        "path": "*",
        "layout": "site",
        "render": "client",
        "component": "src/routes/page/page.tsx",
        "fallback": "src/routes/page/page.fallback.tsx",
        "loader": true,
        "meta": true,
        "queries": ["experience.document.get"],
        "cache": ["page"]
      }
    ],
    "prerender": [],
    "generatedRoutes": [
      {
        "from": "seo.config.ts (resource routes)",
        "paths": ["/robots.txt", "/sitemap.xml", "/sitemaps/:file", "/og/:kind/:id"]
      },
      {
        "from": "i18n.config.ts urlStrategy prefix_except_default",
        "locales": {
          "en": "/",
          "ar": "/ar"
        }
      }
    ],
    "menus": [
      {
        "key": "web.site",
        "class": "SiteMenu",
        "file": "src/menus/site.menu.ts",
        "kind": "navigation"
      },
      {
        "key": "web.footer",
        "class": "FooterMenu",
        "file": "src/menus/footer.menu.ts",
        "kind": "navigation"
      }
    ],
    "blocks": [
      {
        "key": "web.hero_section",
        "class": "HeroSectionBlock",
        "file": "src/blocks/hero-section/hero-section.block.ts",
        "renamedFrom": "web.hero",
        "category": "marketing",
        "icon": "sparkles",
        "renderers": {
          "web": "src/blocks/hero-section/hero-section.tsx"
        },
        "props": {
          "$ref": "#/schemas/web.HeroSectionBlock"
        }
      },
      {
        "key": "web.feature_grid",
        "class": "FeatureGridBlock",
        "file": "src/blocks/feature-grid/feature-grid.block.ts",
        "category": "marketing",
        "icon": "grid",
        "renderers": {
          "web": "src/blocks/feature-grid/feature-grid.tsx"
        },
        "props": {
          "$ref": "#/schemas/web.FeatureGridBlock"
        }
      },
      {
        "key": "web.pricing_table",
        "class": "PricingTableBlock",
        "file": "src/blocks/pricing-table/pricing-table.block.ts",
        "category": "commerce",
        "icon": "receipt",
        "accepts": "billing.catalog.plan.list",
        "renderers": {
          "web": "src/blocks/pricing-table/pricing-table.tsx"
        },
        "props": {
          "$ref": "#/schemas/web.PricingTableBlock"
        }
      },
      {
        "key": "web.testimonials",
        "class": "TestimonialsBlock",
        "file": "src/blocks/testimonials/testimonials.block.ts",
        "category": "content",
        "icon": "quote",
        "accepts": "content.entry.list",
        "renderers": {
          "web": "src/blocks/testimonials/testimonials.tsx"
        },
        "props": {
          "$ref": "#/schemas/web.TestimonialsBlock"
        }
      },
      {
        "key": "web.faq_section",
        "class": "FaqSectionBlock",
        "file": "src/blocks/faq-section/faq-section.block.ts",
        "renamedFrom": "web.faq",
        "category": "content",
        "icon": "question",
        "accepts": "content.entry.list",
        "renderers": {
          "web": "src/blocks/faq-section/faq-section.tsx"
        },
        "props": {
          "$ref": "#/schemas/web.FaqSectionBlock"
        }
      },
      {
        "key": "web.cta_banner",
        "class": "CtaBannerBlock",
        "file": "src/blocks/cta-banner/cta-banner.block.ts",
        "category": "marketing",
        "icon": "megaphone",
        "renderers": {
          "web": "src/blocks/cta-banner/cta-banner.tsx"
        },
        "props": {
          "$ref": "#/schemas/web.CtaBannerBlock"
        }
      },
      {
        "key": "web.product_grid",
        "class": "ProductGridBlock",
        "file": "src/blocks/product-grid/product-grid.block.ts",
        "category": "commerce",
        "icon": "package",
        "accepts": "catalogue.product.list_storefront@1",
        "renderers": {
          "web": "src/blocks/product-grid/product-grid.tsx"
        },
        "props": {
          "$ref": "#/schemas/web.ProductGridBlock"
        }
      }
    ],
    "overrides": [
      {
        "kind": "lang",
        "namespace": "leads",
        "locale": "en",
        "keys": ["refusals.rate_limited", "refusals.captcha_failed"],
        "file": "assets/overrides/leads/en.json"
      },
      {
        "kind": "lang",
        "namespace": "leads",
        "locale": "ar",
        "keys": ["refusals.rate_limited", "refusals.captcha_failed"],
        "file": "assets/overrides/leads/ar.json"
      }
    ]
  },
  "flags": [
    {
      "key": "web.pricing_yearly_first",
      "class": "PricingYearlyFirstFlag",
      "file": "src/flags/pricing-yearly-first.flag.ts",
      "default": false,
      "expires": "2027-03-31",
      "label": "web::flags.pricing_yearly_first.label"
    }
  ],
  "analyticsEvents": [
    {
      "name": "lead.submitted",
      "class": "LeadSubmitted",
      "file": "src/analytics/lead-submitted.analytics-event.ts",
      "payload": {
        "$ref": "#/schemas/web.LeadSubmitted"
      }
    }
  ],
  "errors": [
    {
      "code": "site_context_missing",
      "class": "SiteContextMissingError",
      "file": "src/errors/site-context-missing.error.ts",
      "kind": "precondition_failed",
      "message": "web::errors.site_context_missing.message"
    }
  ],
  "config": [
    {
      "key": "web.env",
      "class": "WebEnv",
      "file": "src/config/env.config.ts"
    },
    {
      "key": "web.edge",
      "class": "EdgeConfig",
      "file": "src/config/edge.config.ts"
    },
    {
      "key": "web.site",
      "class": "SiteConfig",
      "file": "src/config/site.config.ts"
    },
    {
      "key": "web.telemetry",
      "class": "TelemetryConfig",
      "file": "src/config/telemetry.config.ts"
    },
    {
      "key": "analytics",
      "class": "WebAnalyticsConfig",
      "overrides": "@stackra/analytics#AnalyticsConfig"
    },
    {
      "key": "consent",
      "class": "WebConsentConfig",
      "overrides": "@stackra/consent#ConsentConfig"
    },
    {
      "key": "csp",
      "class": "WebCspConfig",
      "overrides": "@stackra/csp#CspConfig"
    },
    {
      "key": "feature_flags",
      "class": "WebFeatureFlagsConfig",
      "overrides": "@stackra/feature-flags#FeatureFlagsConfig"
    },
    {
      "key": "i18n",
      "class": "WebI18nConfig",
      "overrides": "@stackra/i18n#I18nConfig"
    },
    {
      "key": "seo",
      "class": "WebSeoConfig",
      "overrides": "@stackra/seo#SeoConfig"
    },
    {
      "key": "theming",
      "class": "WebThemingConfig",
      "overrides": "@stackra/theming#ThemingConfig"
    }
  ],
  "hatches": [
    {
      "file": "vite.extend.ts",
      "tool": "vite",
      "reason": "no stackra.config.ts section writes into the HTML head, and the build mode in the page is what support asks for first"
    }
  ],
  "secrets": ["TURNSTILE_SECRET_KEY", "GATEWAY_VISITOR_SIGNING_KEY"],
  "assets": {
    "lang": {
      "web": ["en", "ar"]
    },
    "public": ["web::public/logo.svg"]
  },
  "schemas": {
    "web.CallToAction": {
      "type": "object",
      "required": ["label", "route"],
      "properties": {
        "label": {
          "$ref": "@stackra/experience#/schemas/LocalizedText"
        },
        "route": {
          "type": "string",
          "x-stackra-field": "RouteKey: a key of the generated Routes"
        }
      }
    },
    "web.Feature": {
      "type": "object",
      "required": ["icon", "title", "body"],
      "properties": {
        "icon": {
          "$ref": "@stackra/ui#/schemas/Icon"
        },
        "title": {
          "$ref": "@stackra/experience#/schemas/LocalizedText"
        },
        "body": {
          "$ref": "@stackra/experience#/schemas/LocalizedText"
        }
      }
    },
    "web.HeroSectionBlock": {
      "type": "object",
      "required": ["title", "subtitle", "cta"],
      "properties": {
        "title": {
          "$ref": "@stackra/experience#/schemas/LocalizedText"
        },
        "subtitle": {
          "$ref": "@stackra/experience#/schemas/LocalizedText"
        },
        "cta": {
          "$ref": "#/schemas/web.CallToAction"
        },
        "secondary": {
          "$ref": "#/schemas/web.CallToAction"
        }
      }
    },
    "web.FeatureGridBlock": {
      "type": "object",
      "required": ["title", "features"],
      "properties": {
        "title": {
          "$ref": "@stackra/experience#/schemas/LocalizedText"
        },
        "features": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "$ref": "#/schemas/web.Feature"
          }
        }
      }
    },
    "web.PricingTableBlock": {
      "type": "object",
      "required": ["product"],
      "properties": {
        "product": {
          "type": "string"
        }
      }
    },
    "web.TestimonialsBlock": {
      "type": "object",
      "required": ["title", "limit"],
      "properties": {
        "title": {
          "$ref": "@stackra/experience#/schemas/LocalizedText"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "default": 3
        }
      }
    },
    "web.FaqSectionBlock": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": {
          "$ref": "@stackra/experience#/schemas/LocalizedText"
        }
      }
    },
    "web.CtaBannerBlock": {
      "type": "object",
      "required": ["title", "body", "button"],
      "properties": {
        "title": {
          "$ref": "@stackra/experience#/schemas/LocalizedText"
        },
        "body": {
          "$ref": "@stackra/experience#/schemas/LocalizedText"
        },
        "button": {
          "$ref": "#/schemas/web.CallToAction"
        }
      }
    },
    "web.ProductGridBlock": {
      "type": "object",
      "required": ["collection", "limit"],
      "properties": {
        "collection": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "default": 4
        }
      }
    },
    "web.LeadSubmitted": {
      "type": "object",
      "required": ["plan"],
      "properties": {
        "plan": {
          "type": "string"
        }
      }
    },
    "web.ContactInput": {
      "type": "object",
      "required": ["name", "email", "message", "consent", "captchaToken"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "x-stackra-transform": "trim"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254,
          "x-stackra-transform": "trim"
        },
        "company": {
          "type": "string",
          "maxLength": 120,
          "x-stackra-transform": "trim"
        },
        "message": {
          "type": "string",
          "minLength": 12,
          "maxLength": 2000,
          "x-stackra-transform": "trim"
        },
        "consent": {
          "const": true
        },
        "captchaToken": {
          "type": "string",
          "minLength": 1
        },
        "website": {
          "type": "string",
          "maxLength": 0
        },
        "plan": {
          "type": "string",
          "maxLength": 64
        }
      }
    },
    "web.ContactSearch": {
      "type": "object",
      "properties": {
        "plan": {
          "type": "string",
          "maxLength": 64,
          "x-stackra-catch": "dropped when malformed"
        }
      }
    },
    "web.StoreSearch": {
      "type": "object",
      "properties": {
        "q": {
          "type": "string",
          "maxLength": 120,
          "x-stackra-catch": "dropped when malformed"
        },
        "collection": {
          "type": "string",
          "maxLength": 64,
          "x-stackra-catch": "dropped when malformed"
        },
        "cursor": {
          "type": "string",
          "maxLength": 512,
          "x-stackra-catch": "dropped when malformed"
        }
      }
    },
    "web.CacheRule": {
      "type": "object",
      "required": ["freshFor", "staleFor"],
      "properties": {
        "freshFor": {
          "$ref": "@stackra/contracts#/schemas/Duration"
        },
        "staleFor": {
          "$ref": "@stackra/contracts#/schemas/Duration"
        }
      }
    }
  },
  "enums": [
    {
      "key": "web.billing_interval",
      "class": "BillingInterval",
      "file": "src/enums/billing-interval.enum.ts",
      "codes": ["month", "year"],
      "labels": "web::enums.billing_interval.<code>"
    },
    {
      "key": "web.cache_profile",
      "class": "CacheProfile",
      "file": "src/enums/cache-profile.enum.ts",
      "codes": ["marketing", "catalogue", "page", "none"]
    }
  ]
}
