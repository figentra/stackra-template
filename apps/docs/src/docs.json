{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Acme Retail",
  "description": "How the Acme Retail platform is built on Stackra: the commerce service, its decisions, and its public API.",
  "colors": {
    "primary": "#2F6DF6",
    "light": "#F7F7F5",
    "dark": "#1C1E22"
  },
  "fonts": {
    "family": "Geist"
  },
  "favicon": "/assets/favicon.svg",
  "logo": {
    "light": "/assets/logo/light.svg",
    "dark": "/assets/logo/dark.svg",
    "href": "/"
  },
  "appearance": {
    "default": "system"
  },
  "icons": {
    "library": "lucide"
  },
  "search": {
    "prompt": "Search the Acme Retail docs"
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:site_name": "Acme Retail docs"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "errors": {
    "404": {
      "redirect": false,
      "title": "Page not found",
      "description": "This page moved or never existed. Try search."
    }
  },
  "redirects": [
    {
      "source": "/api",
      "destination": "/api-reference/introduction"
    }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "quickstart"]
          },
          {
            "group": "How it is built",
            "pages": ["guides/programming-model", "guides/add-a-field", "guides/testing"]
          }
        ]
      },
      {
        "tab": "Architecture",
        "icon": "landmark",
        "groups": [
          {
            "group": "Decisions",
            "pages": ["adr/index", "adr/0001-loyalty-ledger-is-a-port"]
          }
        ]
      },
      {
        "tab": "API reference",
        "icon": "code",
        "groups": [
          {
            "group": "Using the API",
            "pages": ["api-reference/introduction", "api-reference/events"]
          },
          {
            "group": "Endpoints",
            "openapi": "api-reference/openapi.json"
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/acme"
    }
  }
}
