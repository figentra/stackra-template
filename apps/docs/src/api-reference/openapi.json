  "components": {
    "schemas": {
      "CreateOrderOutput": {
        "type": "object",
        "required": ["orderId", "status", "totals", "paymentClientSecret"],
        "properties": {
          "orderId": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus"
          },
          "totals": {
            "$ref": "#/components/schemas/OrderTotals"
          },
          "paymentClientSecret": {
            "type": "string"
          }
        }
      },
      "CancelOrderInput": {
        "type": "object",
        "required": ["orderId"],
        "properties": {
          "orderId": {
            "type": "string"
          }
        }
      },
      "CancelOrderOutput": {
        "type": "object",
        "required": ["orderId", "status"],
        "properties": {
          "orderId": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus"
          }
        }
      },
      "OrderStatus": {
        "type": "string",
        "enum": ["pending_payment", "paid", "cancelled", "expired"]
      },
      "CancelReason": {
        "type": "string",
        "enum": ["customer", "staff", "expired", "payment_failed"]
      },
      "OrderTotals": {
        "type": "object",
        "required": ["currency", "subtotalMinor", "adjustments", "totalMinor"],
        "properties": {
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "subtotalMinor": {
            "type": "integer",
            "minimum": 0
          },
          "adjustments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["code", "label", "amountMinor"],
              "properties": {
                "code": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "amountMinor": {
                  "type": "integer"
                }
              }
            }
          },
          "totalMinor": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "OrderView": {
        "type": "object",
        "required": ["id", "status", "totals", "lines", "createdAt"],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus"
          },
          "totals": {
            "$ref": "#/components/schemas/OrderTotals"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["variantId", "quantity", "unitPriceMinor"],
              "properties": {
                "variantId": {
                  "type": "string"
                },
                "quantity": {
                  "type": "integer"
                },
                "unitPriceMinor": {
                  "type": "integer"
                }
              }
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "OrderListFilter": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus"
          }
        }
      },
      "OrderPage": {
        "type": "object",
        "required": ["items", "hasMore"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderView"
            }
          },
          "nextCursor": {
            "type": "string"
          },
          "hasMore": {
            "type": "boolean"
          }
        }
      },
      "OrdersTodayOutput": {
        "type": "object",
        "required": ["count", "revenueMinor", "currency", "hourly"],
        "properties": {
          "count": {
            "type": "integer"
          },
          "revenueMinor": {
            "type": "integer"
          },
          "currency": {
            "type": "string"
          },
          "hourly": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 24,
            "maxItems": 24
          }
        }
      },
      "ProductView": {
        "type": "object",
        "required": ["id", "title", "slug", "status", "variants"],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["draft", "active", "archived"]
          },
          "variants": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "sku"],
              "properties": {
                "id": {
                  "type": "string"
                },
                "sku": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "StorefrontProductView": {
        "type": "object",
        "required": [
          "id",
          "title",
          "slug",
          "currency",
          "inStock",
          "images",
          "description",
          "variants",
          "seo",
          "collections"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "inStock": {
            "type": "boolean"
          },
          "images": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["url", "alt"],
              "properties": {
                "url": {
                  "type": "string"
                },
                "alt": {
                  "type": ["string", "null"]
                }
              }
            }
          },
          "description": {},
          "variants": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "sku", "priceMinor", "inStock", "options"],
              "properties": {
                "id": {
                  "type": "string"
                },
                "sku": {
                  "type": "string"
                },
                "priceMinor": {
                  "type": "integer"
                },
                "inStock": {
                  "type": "boolean"
                },
                "options": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "seo": {
            "type": "object",
            "required": ["title", "description", "noindex"],
            "properties": {
              "title": {
                "type": ["string", "null"]
              },
              "description": {
                "type": ["string", "null"]
              },
              "noindex": {
                "type": "boolean"
              }
            }
