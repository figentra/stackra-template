{
  "name": "@acme/loyalty-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Points, tiers and redemption as a module: a ledger port with postgres and memory drivers, an extension point, a redemption workflow, and web and native renderers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra-template.git",
    "directory": "packages/commerce/loyalty-kit"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#src/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ],
    "#config/*": [
      "./src/config/*",
      "./src/config/*.ts",
      "./src/config/*.tsx",
      "./src/config/*/index.ts"
    ],
    "#contracts/*": [
      "./src/contracts/*",
      "./src/contracts/*.ts",
      "./src/contracts/*.tsx",
      "./src/contracts/*/index.ts"
    ],
    "#core/*": [
      "./src/core/*",
      "./src/core/*.ts",
      "./src/core/*.tsx",
      "./src/core/*/index.ts"
    ],
    "#node/*": [
      "./src/node/*",
      "./src/node/*.ts",
      "./src/node/*.tsx",
      "./src/node/*/index.ts"
    ],
    "#react/*": [
      "./src/react/*",
      "./src/react/*.ts",
      "./src/react/*.tsx",
      "./src/react/*/index.ts"
    ],
    "#native/*": [
      "./src/native/*",
      "./src/native/*.ts",
      "./src/native/*.tsx",
      "./src/native/*/index.ts"
    ],
    "#testing/*": [
      "./src/testing/*",
      "./src/testing/*.ts",
      "./src/testing/*.tsx",
      "./src/testing/*/index.ts"
    ],
    "#stackra/*": [
      "./.stackra/gen/*",
      "./.stackra/gen/*.ts",
      "./.stackra/gen/*.tsx",
      "./.stackra/gen/*/index.ts"
    ]
  },
  "exports": {
    ".": "./.stackra/entry/index.ts",
    "./contracts": "./.stackra/entry/contracts.ts",
    "./node": "./.stackra/entry/node.ts",
    "./react": "./.stackra/entry/react.ts",
    "./native": "./.stackra/entry/native.ts",
    "./testing": "./.stackra/entry/testing.ts",
    "./assets/*": "./assets/*"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./contracts": {
        "types": "./dist/contracts.d.mts",
        "import": "./dist/contracts.mjs"
      },
      "./node": {
        "types": "./dist/node.d.mts",
        "import": "./dist/node.mjs"
      },
      "./react": {
        "types": "./dist/react.d.mts",
        "import": "./dist/react.mjs"
      },
      "./native": {
        "types": "./dist/native.d.mts",
        "import": "./dist/native.mjs"
      },
      "./testing": {
        "types": "./dist/testing.d.mts",
        "import": "./dist/testing.mjs"
      },
      "./assets/*": "./assets/*"
    },
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "gen": "stackra gen",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsdown"
  },
  "dependencies": {
    "@stackra/actions": "catalog:stackra",
    "@stackra/app": "catalog:stackra",
    "@stackra/config": "catalog:stackra",
    "@stackra/container": "catalog:stackra",
    "@stackra/contracts": "catalog:stackra",
    "@stackra/database": "catalog:stackra",
    "@stackra/errors": "catalog:stackra",
    "@stackra/events": "catalog:stackra",
    "@stackra/iam": "catalog:stackra",
    "@stackra/ledger": "catalog:stackra",
    "@stackra/model": "catalog:stackra",
    "@stackra/panel": "catalog:stackra",
    "@stackra/queue": "catalog:stackra",
    "@stackra/scheduler": "catalog:stackra",
    "@stackra/search": "catalog:stackra",
    "@stackra/settings": "catalog:stackra",
    "@stackra/tenancy": "catalog:stackra",
    "@stackra/validation": "catalog:stackra",
    "@stackra/versioning": "catalog:stackra",
    "@stackra/workflow": "catalog:stackra",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@stackra/gen": "catalog:stackra",
    "@stackra/testing": "catalog:stackra",
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@vitest/coverage-v8": "catalog:quality",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  },
  "peerDependencies": {
    "@stackra/i18n": "catalog:stackra",
    "@stackra/testing": "catalog:stackra",
    "@stackra/ui": "catalog:stackra",
    "react": "catalog:",
    "react-native": "catalog:mobile"
  },
  "peerDependenciesMeta": {
    "@stackra/testing": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  }
}
