{
  "$comment": "generated by stackra gen from src/** and src/config/*.config.ts — do not edit. Committed through the .stackra gitignore exception (ADR 0158). A package's manifest: what its module contributes to any host; a host's manifest merges it.",
  "member": "@stackra/loyalty-kit",
  "version": "0.1.0",
  "module": { "key": "loyalty_kit", "exports": ["LoyaltyService", "AccountService"] },
  "configs": [
    {
      "key": "loyalty_kit",
      "fields": {
        "ledger": { "driverOf": "loyalty_kit.LoyaltyLedger", "default": "postgres" },
        "ledgers": {
          "driverOf": "loyalty_kit.LoyaltyLedger",
          "named": ["primary", "archive"],
          "default": {}
        },
        "pointValueMinor": 1,
        "earnPerMinor": 0.01,
        "maxRedeemPercent": 50
      }
    }
  ],
  "ports": [
    {
      "port": "loyalty_kit.LoyaltyLedger",
      "drivers": { "postgres": "PostgresLoyaltyLedger", "memory": "MemoryLoyaltyLedger" },
      "selectedBy": "config:loyalty_kit.ledger"
    },
    { "port": "loyalty_kit.LoyaltyMembers", "drivers": {}, "hostDriver": "required" }
  ],
  "actions": [
    {
      "key": "loyalty_kit.account.enroll",
      "kind": "action",
      "permission": "loyalty_kit.loyalty_account.enroll",
      "risk": "L1",
      "actors": ["user", "agent", "service"],
      "adapters": {
        "http": { "method": "PUT", "path": "/loyalty/accounts/:accountId" },
        "mcp": true
      },
      "refusals": ["not_own_principal"]
    },
    {
      "key": "loyalty_kit.points.redeem",
      "kind": "action",
      "permission": "loyalty_kit.loyalty_account.redeem",
      "risk": "L1",
      "idempotency": "required",
      "runs": { "workflow": "RedeemPointsWorkflow", "steps": ["quote", "debit", "confirm"] },
      "adapters": { "http": { "method": "POST", "path": "/loyalty/redemptions" } },
      "hooks": ["LoyaltyHooks.redeemVerify"],
      "refusals": ["not_a_member", "insufficient_points", "workflow_timed_out", "rate_limited"]
    },
    {
      "key": "loyalty_kit.account.freeze",
      "kind": "action",
      "permission": "loyalty_kit.loyalty_account.freeze",
      "risk": "L2",
      "adapters": {
        "http": { "method": "PUT", "path": "/loyalty/accounts/:accountId/freeze" },
        "mcp": true
      }
    },
    {
      "key": "loyalty_kit.points.expire",
      "kind": "action",
      "permission": "loyalty_kit.loyalty_account.expire",
      "risk": "L2",
      "actors": ["system", "job"],
      "adapters": {
        "job": { "queue": "maintenance", "unique": true },
        "cron": { "schedule": "0 3 * * *", "perTenant": true }
      }
    },
    {
      "key": "loyalty_kit.points.balance",
      "kind": "query",
      "permission": "loyalty_kit.loyalty_account.read",
      "risk": "L0",
      "cache": {
        "ttl": "1m",
        "invalidateOn": ["loyalty_kit.points.earned.v2", "loyalty_kit.points.redeemed.v1"]
      },
      "adapters": {
        "http": { "method": "GET", "path": "/loyalty/accounts/:accountId/balance" },
        "mcp": "auto"
      }
    },
    {
      "key": "loyalty_kit.points.stats_today",
      "kind": "query",
      "permission": "loyalty_kit.loyalty_account.read",
      "risk": "L0",
      "adapters": { "mcp": "auto" }
    },
    {
      "key": "loyalty_kit.loyalty_account.list",
      "kind": "query",
      "generatedBy": "@Crud(LoyaltyAccount)",
      "permission": "loyalty_kit.loyalty_account.read",
      "risk": "L0",
      "policy": "LoyaltyAccountPolicy.read",
      "output": "Page(LoyaltyAccountView)",
      "adapters": { "http": { "method": "GET", "path": "/loyalty/accounts" } }
    }
  ],
  "events": [
    { "name": "loyalty_kit.account.enrolled.v1", "class": "AccountEnrolled", "public": true },
    {
      "name": "loyalty_kit.points.earned.v2",
      "class": "PointsEarned",
      "public": true,
      "alsoPublish": [1],
      "sunset": "2027-04-01",
      "upcasts": [{ "from": 1, "class": "PointsEarnedFromV1" }]
    },
    { "name": "loyalty_kit.points.redeemed.v1", "class": "PointsRedeemed", "public": false },
    { "name": "loyalty_kit.account.frozen.v1", "class": "AccountFrozen", "public": true }
  ],
  "hooks": {
    "LoyaltyHooks.earnAdjust": {
      "kind": "transform",
      "implementers": [{ "order": 100, "class": "TierMultiplierHook" }]
    },
    "LoyaltyHooks.redeemVerify": { "kind": "verify", "implementers": [] }
  },
  "permissions": [
    "loyalty_kit.loyalty_account.read",
    "loyalty_kit.loyalty_account.enroll",
    "loyalty_kit.loyalty_account.freeze",
    "loyalty_kit.loyalty_account.redeem",
    "loyalty_kit.loyalty_account.expire",
    "loyalty_kit.settings.update"
  ],
  "settings": { "loyalty_kit": ["expiryMonths", "silverFrom", "goldFrom"] },
  "models": [
    { "key": "loyalty_kit.loyalty_account", "table": "loyalty_accounts", "tenantOwned": true },
    {
      "key": "loyalty_kit.ledger_entry",
      "table": "loyalty_ledger_entries",
      "tenantOwned": true,
      "appendOnly": true
    }
  ],
  "migrations": [
    { "from": "@stackra/loyalty-kit/node", "class": "CreateLoyaltyTables" },
    { "from": "@stackra/loyalty-kit/node", "class": "LedgerEntriesAccountIdIndex" }
  ],
  "seeds": [{ "key": "loyalty_kit.demo", "class": "DemoSeeder", "profiles": ["demo"] }],
  "ui": {
    "resources": [{ "key": "loyalty_kit.loyalty_account", "realms": ["tenant_admin"] }],
    "widgets": [
      {
        "class": "PointsIssuedWidget",
        "component": "loyalty_kit.points_issued_tile",
        "realms": ["tenant_admin"]
      }
    ],
    "documents": [
      { "class": "LoyaltyOverviewDocument", "path": "/loyalty", "realms": ["customer"] }
    ],
    "settings": [{ "key": "loyalty_kit", "realms": ["tenant_admin"] }],
    "overridePoints": {
      "loyalty_kit.points_balance_tile": { "registeredBy": "./react" },
      "loyalty_kit.points_issued_tile": { "registeredBy": "./react" }
    }
  },
  "assets": { "lang": { "loyalty_kit": ["en", "ar"] } }
}
