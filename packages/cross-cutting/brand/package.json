{
  "name": "@stackra/brand",
  "version": "0.1.0",
  "description": "Design tokens and brand assets shared by every app, service template and mail; one TypeScript token source, CSS generated from it.",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#core/*": "./src/core/*",
    "#stackra/*": [
      "./.stackra/gen/*.ts",
      "./.stackra/gen/*.tsx"
    ]
  },
  "exports": {
    ".": "./src/index.ts",
    "./css/tokens.css": "./css/tokens.css",
    "./css/native.css": "./css/native.css",
    "./assets/*": "./assets/*"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./css/tokens.css": "./css/tokens.css",
      "./css/native.css": "./css/native.css",
      "./assets/*": "./assets/*"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "gen": "stackra gen",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format:check": "oxfmt --check .",
    "build": "tsdown"
  },
  "devDependencies": {
    "@stackra/gen": "catalog:stackra",
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "tsdown": "catalog:build",
    "typescript": "catalog:build"
  }
}
