{
  "name": "@acme/brand",
  "version": "0.1.0",
  "private": true,
  "description": "Design tokens and brand assets shared by every app, service template and mail; one TypeScript token source, CSS generated from it.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra-template.git",
    "directory": "packages/cross-cutting/brand"
  },
  "files": [
    "dist",
    "assets",
    "css",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "./css/*.css"
  ],
  "imports": {
    "#src/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ],
    "#core/*": [
      "./src/core/*",
      "./src/core/*.ts",
      "./src/core/*.tsx",
      "./src/core/*/index.ts"
    ],
    "#stackra/*": [
      "./.stackra/gen/*",
      "./.stackra/gen/*.ts",
      "./.stackra/gen/*.tsx",
      "./.stackra/gen/*/index.ts"
    ]
  },
  "exports": {
    ".": "./src/index.ts",
    "./css/tokens.css": "./css/tokens.css",
    "./css/native.css": "./css/native.css",
    "./assets/*": "./assets/*"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./css/tokens.css": "./css/tokens.css",
      "./css/native.css": "./css/native.css",
      "./assets/*": "./assets/*"
    },
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "gen": "stackra gen",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsdown"
  },
  "devDependencies": {
    "@stackra/gen": "catalog:stackra",
    "@stackra/testing": "catalog:stackra",
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@vitest/coverage-v8": "catalog:quality",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  }
}
