{
  "name": "@figentra/acme-example",
  "version": "0.0.0",
  "private": true,
  "description": "An example package: its console page, mobile screen and landing block show how a product ships packages into the OS shells. Rename it to the product's first package or delete it.",
  "keywords": [
    "application",
    "stackra"
  ],
  "license": "UNLICENSED",
  "files": [
    "dist",
    "src",
    "assets",
    "stackra.manifest.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "./src/landing.ts",
    "./src/core/blocks/**/*.block.ts",
    "./dist/landing.mjs"
  ],
  "imports": {
    "#core/*": [
      "./src/core/*",
      "./src/core/*.ts",
      "./src/core/*/index.ts"
    ],
    "#native/*": [
      "./src/native/*",
      "./src/native/*.ts",
      "./src/native/*.tsx",
      "./src/native/*/index.ts"
    ],
    "#react/*": [
      "./src/react/*",
      "./src/react/*.ts",
      "./src/react/*.tsx",
      "./src/react/*/index.ts"
    ],
    "#src/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ],
    "#assets/*": "./assets/*"
  },
  "exports": {
    "./console": {
      "@stackra/source": "./src/console.tsx",
      "types": "./dist/console.d.mts",
      "default": "./dist/console.mjs"
    },
    "./landing": {
      "@stackra/source": "./src/landing.ts",
      "types": "./dist/landing.d.mts",
      "default": "./dist/landing.mjs"
    },
    "./native": {
      "@stackra/source": "./src/native.tsx",
      "types": "./dist/native.d.mts",
      "default": "./dist/native.mjs"
    },
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "build": "stackra build",
    "typecheck": "stackra typecheck",
    "lint": "stackra lint",
    "test": "stackra test",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist coverage .turbo .stackra"
  },
  "dependencies": {
    "@stackra/contracts": "catalog:stackra",
    "@stackra/experience": "catalog:stackra",
    "@stackra/icons": "catalog:stackra",
    "@stackra/ui": "catalog:stackra",
    "@stackra/validation": "catalog:stackra",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@stackra/cli": "catalog:stackra",
    "@stackra/testing": "catalog:stackra",
    "@stackra/tsdown-config": "catalog:stackra",
    "@stackra/typescript-config": "catalog:stackra",
    "@stackra/vitest-config": "catalog:stackra",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:quality",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "react": "catalog:",
    "react-native": "catalog:mobile",
    "react-router": "catalog:",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-native": "catalog:mobile",
    "react-router": "catalog:"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "react-router": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "lib",
    "category": "application",
    "runtimes": [
      "isomorphic",
      "browser",
      "react-native"
    ]
  }
}
