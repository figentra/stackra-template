{
  "name": "@stackra/vitest-config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared vitest presets: base, decorators (legacy decorators, no metadata), react (jsdom), and the member factories nodePreset, libraryPreset, reactPreset and nativePreset.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./preset": "./src/preset.ts",
    "./preset-decorators": "./src/preset-decorators.ts",
    "./preset-react": "./src/preset-react.ts",
    "./coverage": "./src/coverage.ts"
  },
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "jsdom": "catalog:quality",
    "vitest": "catalog:quality"
  },
  "devDependencies": {
    "@stackra/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "typescript": "catalog:build"
  }
}
