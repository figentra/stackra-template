// Stackra file contract:
// Purpose: React 19 code: the react entries of packages and the web apps; the base plus browser
//          globals, the hooks rules and accessibility checks (jsx-a11y).
// Boundary: React and accessibility rules only, on top of base.jsonc.
// Runtime: node
// Governing contract: Stackra ADR 0129 (house lint rules), Stackra ADR 0165 (web client stack)
{
  "extends": ["./base.jsonc"],
  "plugins": ["react", "jsx-a11y"],
  "env": { "browser": true },
  "rules": {
    "react/jsx-no-target-blank": "error",
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn"
  }
}
