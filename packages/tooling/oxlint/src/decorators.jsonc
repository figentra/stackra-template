// Stackra file contract:
// Purpose: code that declares kind classes (`extends Action({ key })`) with field, method and
//          class facet decorators (legacy decorators, Stackra ADR 0005 and ADR 0294 rule R6). Kind
//          base factories and decorator factories are PascalCase calls, so `new-cap` must not treat
//          them as constructors. `typescript/consistent-type-imports` stays on from base: a class
//          used only as a type (a constructor dependency) is imported with `import type`, and a
//          class used as a value (a base factory argument, `X.create()`) keeps its value import.
// Boundary: decorator-related rules only, on top of node.jsonc.
// Runtime: node
// Governing contract: Stackra ADR 0005 (legacy decorators), Stackra ADR 0294 (rules R3 and R6),
//                     Stackra ADR 0129 (house lint rules)
{
  "extends": ["./node.jsonc"],
  "rules": {
    "eslint/new-cap": ["warn", { "capIsNew": false }],
    // A class with only a facet decorator and no members stays legal; a kind class with no body
    // (`class OrdersModule extends Module({ ... }) {}`) is not extraneous, because it extends.
    "typescript/no-extraneous-class": ["error", { "allowWithDecorator": true }]
  },
  "overrides": [
    {
      // Tests use empty classes as tokens and test doubles.
      "files": ["**/__tests__/**/*.ts", "**/__fixtures__/**/*.ts"],
      "rules": { "typescript/no-extraneous-class": "off" }
    }
  ]
}
