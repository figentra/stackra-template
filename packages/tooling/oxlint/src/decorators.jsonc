// Stackra file contract:
// Purpose: code that declares decorated classes (legacy decorators, Stackra ADR 0005). Decorator
//          factories are PascalCase, so `new-cap` must not treat them as constructors.
//          `typescript/consistent-type-imports` stays on from base: a class used only as a type is
//          imported with `import type`, and a class used as a value keeps its value import.
// Boundary: decorator-related rules only, on top of node.jsonc.
// Runtime: node
// Governing contract: Stackra ADR 0005 (legacy decorators), Stackra ADR 0129 (house lint rules)
{
  "extends": ["./node.jsonc"],
  "rules": {
    "eslint/new-cap": ["warn", { "capIsNew": false }],
    // An empty `@Module({...}) class X {}` is the normal spelling of a module.
    "typescript/no-extraneous-class": ["error", { "allowWithDecorator": true }]
  },
  "overrides": [
    {
      // Tests use empty classes as tokens and test doubles.
      "files": ["**/__tests__/**/*.ts", "**/__fixtures__/**/*.ts"],
      "rules": { "typescript/no-extraneous-class": "off" }
    }
  ]
}
