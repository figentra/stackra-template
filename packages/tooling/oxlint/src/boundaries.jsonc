// Stackra file contract:
// Purpose: the repo-wide entry carrying the tier dependency rule (Stackra ADR 0003): a package
//          (packages/<category>/<name>) never imports an app, a service or encore.dev; a service never
//          imports another service or hand-written Encore; an app never imports a service; nothing imports
//          a package's src/ deep path. Package runtime splits (Stackra ADR 0004): core/ and contracts/
//          are isomorphic, react/ never reaches node/, native/ never reaches node/ or react-dom.
//          oxlint does not merge one rule across overrides: the LAST matching override's options replace
//          the earlier ones. So the no-restricted-imports overrides run general → specific and each one
//          repeats the patterns of the broader ones it narrows. Keep that when adding a pattern.
//          Not here, because they need the module graph: cross-module internals inside one member (gen
//          fails on the import) and links point down (planned rule `no-upward-route-import`: only a route
//          imports its layout and page class; everything else uses `Routes.x` from #stackra/routes).
//          Service packages are matched by name in any npm scope (`@<scope>/service-<name>`), so the
//          preset names no project's scope; service paths are matched as `services/<name>/src` or
//          `services/<name>/.stackra`, so a member's own `services/` kind folder
//          (`#node/services/x.service`) is not mistaken for a service member.
// Boundary: import bans only; every other rule comes from node.jsonc, and the decorator rules from the
//           last override below.
// Runtime: node
// Governing contract: Stackra ADR 0003 (tier direction), Stackra ADR 0004 (package entries), Stackra
//                     ADR 0260 (cross-service calls through clients and events)
{
  "extends": ["./node.jsonc"],
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@*/*/src/*"],
                "message": "Deep imports into a package's src/ bypass its public exports. Import the package or one of its declared subpaths."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/services/**/*.ts", "**/services/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@*/*/src/*"],
                "message": "Deep imports into a package's src/ bypass its public exports. Import the package or one of its declared subpaths."
              },
              {
                "group": ["encore.dev", "encore.dev/*", "~encore/*", "@*/service-*"],
                "message": "A service is plain TypeScript: no hand-written Encore (gen emits it into .stackra/encore/, Stackra ADR 0091, 0124) and no other service's package. Reach another service through its generated client from #stackra/clients or listen to its events (Stackra ADR 0260)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/apps/**/*.ts", "**/apps/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@*/*/src/*"],
                "message": "Deep imports into a package's src/ bypass its public exports. Import the package or one of its declared subpaths."
              },
              {
                "group": [
                  "encore.dev",
                  "encore.dev/*",
                  "~encore/*",
                  "@*/service-*",
                  "**/services/*/src/**",
                  "**/services/*/.stackra/**"
                ],
                "message": "An app never imports a service or encore.dev. Call it through the generated client from #stackra/clients (Stackra ADR 0003, 0260)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/packages/**/*.ts", "**/packages/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@*/*/src/*"],
                "message": "Deep imports into a package's src/ bypass its public exports. Import the package or one of its declared subpaths."
              },
              {
                "group": [
                  "**/apps/**",
                  "**/services/*/src/**",
                  "**/services/*/.stackra/**",
                  "@*/service-*",
                  "encore.dev",
                  "encore.dev/*",
                  "~encore/*"
                ],
                "message": "A package never imports an app, a service or encore.dev. Move the dependency the other way, or define a port in the package's ./contracts that the service implements (Stackra ADR 0260)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/packages/*/*/src/core/**/*.ts",
        "**/packages/*/*/src/contracts/**/*.ts",
        "**/packages/*/*/src/core/**/*.tsx",
        "**/packages/*/*/src/contracts/**/*.tsx"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@*/*/src/*"],
                "message": "Deep imports into a package's src/ bypass its public exports. Import the package or one of its declared subpaths."
              },
              {
                "group": [
                  "**/apps/**",
                  "**/services/*/src/**",
                  "**/services/*/.stackra/**",
                  "@*/service-*",
                  "encore.dev",
                  "encore.dev/*",
                  "~encore/*"
                ],
                "message": "A package never imports an app, a service or encore.dev. Move the dependency the other way, or define a port in the package's ./contracts that the service implements (Stackra ADR 0260)."
              },
              {
                "group": [
                  "#node",
                  "#node/*",
                  "#react",
                  "#react/*",
                  "#native",
                  "#native/*",
                  "react",
                  "react-dom",
                  "react-native"
                ],
                "message": "core/ and contracts/ are isomorphic: no runtime split (node/, react/, native/) and no host library (Stackra ADR 0004)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/packages/*/*/src/react/**/*.ts", "**/packages/*/*/src/react/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@*/*/src/*"],
                "message": "Deep imports into a package's src/ bypass its public exports. Import the package or one of its declared subpaths."
              },
              {
                "group": [
                  "**/apps/**",
                  "**/services/*/src/**",
                  "**/services/*/.stackra/**",
                  "@*/service-*",
                  "encore.dev",
                  "encore.dev/*",
                  "~encore/*"
                ],
                "message": "A package never imports an app, a service or encore.dev. Move the dependency the other way, or define a port in the package's ./contracts that the service implements (Stackra ADR 0260)."
              },
              {
                "group": ["#node", "#node/*"],
                "message": "react/ runs in the browser and React Native: it never imports the node/ runtime split (Stackra ADR 0004)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/packages/*/*/src/native/**/*.ts", "**/packages/*/*/src/native/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@*/*/src/*"],
                "message": "Deep imports into a package's src/ bypass its public exports. Import the package or one of its declared subpaths."
              },
              {
                "group": [
                  "**/apps/**",
                  "**/services/*/src/**",
                  "**/services/*/.stackra/**",
                  "@*/service-*",
                  "encore.dev",
                  "encore.dev/*",
                  "~encore/*"
                ],
                "message": "A package never imports an app, a service or encore.dev. Move the dependency the other way, or define a port in the package's ./contracts that the service implements (Stackra ADR 0260)."
              },
              {
                "group": ["#node", "#node/*", "react-dom", "react-dom/*"],
                "message": "native/ composes react, never node/ or react-dom (Stackra ADR 0004)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/packages/**/*.ts",
        "**/apps/**/*.ts",
        "**/services/**/*.ts",
        "**/packages/**/*.tsx",
        "**/apps/**/*.tsx",
        "**/services/**/*.tsx"
      ],
      // Decorator factories are PascalCase, so `new-cap` must not treat them as constructors; an empty
      // decorated class (`@Module({...}) class X {}`) is the normal spelling of a kind.
      "rules": {
        "eslint/new-cap": [
          "warn",
          {
            "capIsNew": false
          }
        ],
        "typescript/no-extraneous-class": [
          "error",
          {
            "allowWithDecorator": true
          }
        ]
      }
    },
    {
      "files": [
        "**/packages/**/src/react/**/*.{ts,tsx}",
        "**/packages/**/src/native/**/*.{ts,tsx}",
        "**/apps/**/*.tsx"
      ],
      "plugins": ["react"],
      "rules": {
        "react/react-in-jsx-scope": "off",
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "warn"
      }
    },
    {
      "files": ["**/__tests__/**/*.ts", "**/__tests__/**/*.tsx", "**/__fixtures__/**/*.ts"],
      "rules": {
        "typescript/no-extraneous-class": "off"
      }
    }
  ]
}
