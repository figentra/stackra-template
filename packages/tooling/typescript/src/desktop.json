// Stackra file contract:
// Purpose: the `desktop` program: the Electron main process and the preload of an app with a
//          desktop target (`.stackra/desktop/` of apps/console). Node's types and no DOM, because
//          main is Node; legacy decorators, because main resolves the decorated config and menu
//          classes from `src`.
// Boundary: only the tsconfig gen writes into `.stackra/desktop/` extends it, never an authored
//           member; `stackra typecheck` runs it beside the app's renderer program. The renderer's
//           `bridge-client.ts` stays in the app program (it types `window.stackra`), so it is
//           excluded here.
// Runtime: node
// Governing contract: Stackra ADR 0058 (desktop is Electron), Stackra ADR 0005 (legacy decorators,
//                     no metadata)
{
  "display": "@stackra/typescript-config — desktop (Electron main and preload)",
  "extends": "./node.json",
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "erasableSyntaxOnly": false
  },
  "include": ["${configDir}/*.ts"],
  "exclude": ["${configDir}/bridge-client.ts"]
}
