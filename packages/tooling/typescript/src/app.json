// Stackra file contract:
// Purpose: the `app` role: a Vite or React Router app (apps/console, apps/web) whose routes,
//          layouts, menus, stores and config are kind classes with field decorators. The vite
//          building block (DOM lib, vite/client types) plus the decorator flags, set here
//          explicitly because a multi-extends chain lets the last preset's `lib`/`types`/`include`
//          win and would drop the DOM lib.
// Boundary: a member's tsconfig.json is exactly `{ "extends": "@stackra/typescript-config/app" }`;
//           it covers the app's source, its stackra.config.ts, its `*.extend.ts` hatches and the
//           generated `.stackra/` (the runtime entries in `.stackra/entry/`, the tool configs and
//           `.stackra/gen`). The Electron main process (`.stackra/desktop/`) and the service worker
//           (`.stackra/sw.ts`) are left out: they run without the DOM, so gen gives each its own
//           program (the `desktop` and `service-worker` presets) and `stackra typecheck` runs all
//           three.
// Runtime: node
// Governing contract: Stackra ADR 0005 (legacy decorators, no metadata), Stackra ADR 0295
//                     (generated entries and tool configs), Stackra ADR 0261 (generated
//                     `.stackra/`)
{
  "display": "@stackra/typescript-config — app",
  "extends": "./vite.json",
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "erasableSyntaxOnly": false
  },
  "include": [
    "${configDir}/src",
    "${configDir}/stackra.config.ts",
    "${configDir}/*.extend.ts",
    "${configDir}/.stackra"
  ],
  // An `exclude` replaces the inherited list, so vite's entries are repeated before the two
  // programs above.
  "exclude": [
    "${configDir}/node_modules",
    "${configDir}/dist",
    "${configDir}/build",
    "${configDir}/.turbo",
    "${configDir}/coverage",
    "${configDir}/test-results",
    "${configDir}/playwright-report",
    "${configDir}/.stackra/desktop",
    "${configDir}/.stackra/sw.ts"
  ]
}
