// Stackra file contract:
// Purpose: the `service-worker` program: an app's generated PWA service worker (`.stackra/sw.ts`),
//          with the WebWorker library instead of the DOM. The two libraries declare the same
//          globals differently, so the worker cannot share the renderer's program.
// Boundary: only the `tsconfig.sw.json` gen writes into an app's `.stackra/` extends it, never an
//           authored member; `stackra typecheck` runs it beside the app's renderer program.
// Runtime: node
// Governing contract: Stackra ADR 0165 (web client stack)
{
  "display": "@stackra/typescript-config — service worker",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2022", "WebWorker"],
    "types": []
  },
  "include": ["${configDir}/sw.ts"]
}
