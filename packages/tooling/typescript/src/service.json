// Stackra file contract:
// Purpose: the `service` role: a service member (services/<name>), plain TypeScript on Node with
//          legacy decorators and React Email templates (`resources/<model>/*.mail.tsx`), plus the
//          member files gen reads and writes: stackra.config.ts, .stackra/gen (code imports it as
//          #stackra/*), the runtime entry in .stackra/entry and the tool configs gen writes into
//          .stackra/.
// Boundary: a member's tsconfig.json is exactly `{ "extends": "@stackra/typescript-config/service" }`.
//           Hand-written Encore never appears; `stackra gen` emits it into .stackra/encore with its
//           own tsconfig, which extends `encore`, so that folder stays out of this program.
// Runtime: node
// Governing contract: Stackra ADR 0091, Stackra ADR 0124 (Encore is generated), Stackra ADR 0295
//                     decisions 5 and 7 (generated tool configs and entries), Stackra ADR 0005
//                     (legacy decorators, no metadata)
{
  "display": "@stackra/typescript-config — service",
  "extends": "./library.json",
  "include": [
    "${configDir}/src",
    "${configDir}/stackra.config.ts",
    "${configDir}/.stackra/gen",
    "${configDir}/.stackra/entry",
    "${configDir}/.stackra/*.config.ts"
  ]
}
