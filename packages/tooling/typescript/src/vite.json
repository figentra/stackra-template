// Stackra file contract:
// Purpose: building block for Vite-built React apps: react plus Vite's client types (import.meta.env,
//          asset imports), Node types for config files and the vitest globals.
// Boundary: not a role; app extends it. A member extends a role preset.
// Runtime: node
// Governing contract: Stackra ADR 0165 (web client stack)
{
  "display": "@stackra/typescript-config — vite",
  "extends": "./react.json",
  "compilerOptions": { "types": ["vite/client", "node", "vitest/globals"] },
  "exclude": [
    "${configDir}/node_modules",
    "${configDir}/dist",
    "${configDir}/build",
    "${configDir}/.turbo",
    "${configDir}/coverage",
    "${configDir}/test-results",
    "${configDir}/playwright-report"
  ]
}
