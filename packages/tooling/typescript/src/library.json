// Stackra file contract:
// Purpose: the `library` role: a tsdown-built package (packages/<category>/<name>) with its
//          contracts, core, node, react and native entries. Node and vitest-global types, the DOM
//          library and the automatic JSX runtime (for the react and native entries), and legacy
//          decorators for its field, method and class facet decorators. The declaration flags in
//          base feed tsdown's dts step, so a library declares `@types/node` and `vitest` as
//          devDependencies.
// Boundary: a member's tsconfig.json is exactly `{ "extends": "@stackra/typescript-config/library" }`;
//           it covers src, stackra.config.ts, the generated `.stackra/gen`, the entry barrels gen
//           writes into `.stackra/entry/` (what package.json `exports` point at) and the tsdown and
//           vitest configs gen writes into `.stackra/`.
// Runtime: node
// Governing contract: Stackra ADR 0294 (decision 15: package entry folders; rule R6: the decorator
//                     categories), Stackra ADR 0295 decision 5 (generated tool configs), Stackra
//                     ADR 0005 (legacy decorators, no metadata)
{
  "display": "@stackra/typescript-config — library",
  "extends": "./node.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vitest/globals"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "erasableSyntaxOnly": false
  },
  "include": [
    "${configDir}/src",
    "${configDir}/stackra.config.ts",
    "${configDir}/.stackra/gen",
    "${configDir}/.stackra/entry",
    "${configDir}/.stackra/*.config.ts"
  ]
}
