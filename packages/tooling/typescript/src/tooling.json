// Stackra file contract:
// Purpose: the `tooling` role: the preset packages in packages/tooling, whose files plain Node, Vite
//          or the tool itself loads (`./x.ts` imports stay, base allowImportingTsExtensions).
// Boundary: a member's tsconfig.json is exactly `{ "extends": "@stackra/typescript-config/tooling" }`;
//           it covers src and the package's root config files.
// Runtime: node
// Governing contract: Stackra ADR 0027 (one toolchain), Stackra ADR 0129 (house tooling)
{
  "display": "@stackra/typescript-config — tooling",
  "extends": "./node.json",
  "include": ["${configDir}/*.ts", "${configDir}/src"]
}
