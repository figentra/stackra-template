// Stackra file contract:
// Purpose: the `mobile` role: the Expo / React Native app (apps/mobile), navigated with code-based
//          React Navigation. The strict base plus expo/tsconfig.base's options, inlined because a
//          preset cannot `extends` a package its own folder does not install.
// Boundary: a member's tsconfig.json is exactly `{ "extends": "@stackra/typescript-config/mobile" }`;
//           it covers the app's source, stackra.config.ts, its `*.extend.ts` hatches and the generated
//           `.stackra/` (the runtime entry in `.stackra/entry/`, the Expo and Metro config, and the
//           Uniwind types gen writes there).
// Runtime: node
// Governing contract: Stackra ADR 0005 (legacy decorators, no metadata), Stackra ADR 0294 rule R6
//                     (field, method and class facet decorators in every member, mobile included),
//                     Stackra ADR 0295 (generated entries and tool configs)
{
  "display": "@stackra/typescript-config — mobile",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "ESNext"],
    "module": "preserve",
    "moduleDetection": "force",
    "customConditions": ["react-native", "@stackra/source"],
    "jsx": "react-jsx",
    "allowJs": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "erasableSyntaxOnly": false,
    "types": []
  },
  "include": [
    "${configDir}/src",
    "${configDir}/stackra.config.ts",
    "${configDir}/*.extend.ts",
    "${configDir}/.stackra"
  ],
  "exclude": [
    "${configDir}/node_modules",
    "${configDir}/dist",
    "${configDir}/coverage",
    "${configDir}/android",
    "${configDir}/ios"
  ]
}
