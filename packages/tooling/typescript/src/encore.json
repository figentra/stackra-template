// Stackra file contract:
// Purpose: the generated Encore.ts application (`.stackra/encore/` of a service, written by `stackra
//          gen`). encore.dev's `types` condition points at its .ts sources, which the strict baseline
//          rejects; the `paths` below resolve `encore.dev/*` to the package's shipped
//          `dist/**/*.d.ts`, so skipLibCheck covers it. Four baseline flags stay off because the
//          generated `encore.gen` glue trips them; oxlint keeps the same hygiene (no-unused-vars,
//          consistent-type-imports) on authored code. `declaration` is off: the app emits nothing.
// Boundary: only gen's own tsconfig in `.stackra/encore/` extends it; never an authored member.
// Runtime: node
// Governing contract: Stackra ADR 0091, Stackra ADR 0124 (Encore is generated into .stackra/encore)
{
  "display": "@stackra/typescript-config — encore",
  "extends": "./node.json",
  "compilerOptions": {
    "verbatimModuleSyntax": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitOverride": false,
    "exactOptionalPropertyTypes": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node", "vitest/globals"],
    "paths": {
      "~encore/*": ["${configDir}/encore.gen/*"],
      "encore.dev": ["${configDir}/node_modules/encore.dev/dist/mod.d.ts"],
      "encore.dev/*": ["${configDir}/node_modules/encore.dev/dist/*/mod.d.ts"]
    }
  },
  // encore.gen/internal is the CLI's own runtime glue; it imports encore.dev sources the `paths`
  // above avoid.
  "exclude": [
    "${configDir}/node_modules",
    "${configDir}/encore.gen/internal",
    "${configDir}/.encore"
  ]
}
