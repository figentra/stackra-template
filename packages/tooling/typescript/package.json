{
  "name": "@stackra/typescript-config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared tsconfig presets by role: a member's tsconfig.json is exactly { \"extends\": \"@stackra/typescript-config/<role>\" } with app, mobile, library, service or tooling, and adds no compiler options of its own.",
  "license": "MIT",
  "files": [
    "src/*.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "./app": "./src/app.json",
    "./mobile": "./src/mobile.json",
    "./library": "./src/library.json",
    "./service": "./src/service.json",
    "./tooling": "./src/tooling.json",
    "./desktop": "./src/desktop.json",
    "./service-worker": "./src/service-worker.json",
    "./encore": "./src/encore.json",
    "./runtime": "./src/runtime.json"
  },
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "vitest": "catalog:quality"
  }
}
