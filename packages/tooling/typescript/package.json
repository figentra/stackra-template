{
  "name": "@stackra/typescript-config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared tsconfig presets, imported with their file name (`@stackra/typescript-config/service.json`). A member extends exactly one role preset and adds no compiler options of its own.",
  "license": "MIT",
  "files": [
    "src/*.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./src/base.json",
    "./base.json": "./src/base.json",
    "./node.json": "./src/node.json",
    "./library.json": "./src/library.json",
    "./decorators.json": "./src/decorators.json",
    "./decorators-react.json": "./src/decorators-react.json",
    "./service.json": "./src/service.json",
    "./encore.json": "./src/encore.json",
    "./react.json": "./src/react.json",
    "./vite.json": "./src/vite.json",
    "./vite-node.json": "./src/vite-node.json",
    "./runtime.json": "./src/runtime.json",
    "./app.json": "./src/app.json",
    "./expo.json": "./src/expo.json"
  },
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "vitest": "catalog:quality"
  }
}
