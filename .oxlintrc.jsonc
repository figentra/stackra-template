// Stackra file contract:
// Purpose: root oxlint entry: extends the shared boundaries preset of @stackra/oxlint-config, which
//          carries the tier dependency rule, so it applies to every member from here.
// Boundary: one `extends` line and repo-level ignores. Rules are never written in this file; change
//           the preset.
// Runtime: node
// Governing contract: ADR 0003 (tier direction), ADR 0129 (house lint rules)
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["@stackra/oxlint-config/boundaries"],
  "ignorePatterns": ["**/node_modules/**", "**/dist/**", "**/coverage/**", "**/.stackra/gen/**"],
}
