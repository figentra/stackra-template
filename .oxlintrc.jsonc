// Stackra file contract:
// Purpose: root oxlint entry: extends the boundaries preset of packages/tooling/oxlint
//          (@stackra/oxlint-config), which carries the tier dependency rule, so it applies to every
//          member from here.
// Boundary: one `extends` line and repo-level ignores. Rules are never written in this file; change
//           the preset. A preset's ignorePatterns resolve relative to the preset file, so the repo-level
//           ones live here. The path is relative because oxlint resolves `extends` as a file path.
// Runtime: node
// Governing contract: Stackra ADR 0003 (tier direction), Stackra ADR 0129 (house lint rules)
{
  "$schema": "https://unpkg.com/oxlint@1.86.0/configuration_schema.json",
  "extends": ["./packages/tooling/oxlint/src/boundaries.jsonc"],
  "ignorePatterns": [
    // oxlint follows workspace symlinks; a bare name pattern stops the traversal
    "node_modules",
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    // generated by stackra gen, never hand-edited
    "**/.stackra/gen/**",
    // Expo: generated native projects and the CLI cache
    "**/ios/**",
    "**/android/**",
    "**/.expo/**",
    // lint fixtures are banned imports on purpose; their test lints them with the preset directly
    "**/__tests__/fixtures/**"
  ]
}
